        <mxCell id="badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="123" y="400" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="278" y="466" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="746" y="320" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="546" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="706" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="866" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="212" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1550" y="30" width="650" height="1040" as="geometry" /></mxCell>
        <mxCell id="legend-step-1" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="60" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-1"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Run the lab scripts&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Every command runs inside lab14-tools with docker exec. Nothing needs Python on the host.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-1"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-2" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="170" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-2"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Publish to a work queue&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The producer returns in milliseconds. Competing workers share the orders queue: each message goes to one worker, which acknowledges it only after the work is done. Unacknowledged messages come back if a worker dies.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-2"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-3" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="280" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-3"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Retry, then dead-letter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; A poison order is retried three times. Then the worker rejects it and the broker routes it through orders.dlx to orders.dlq for a human to inspect.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-3"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-4" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="390" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-4"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Fan out an event&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; order-events is a fanout exchange: every bound queue receives its own copy of the same event.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-4"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-5" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="500" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-5"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Route by topic&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; order-topic compares the routing key with each binding pattern, such as order.*.mx or order.#, and delivers only to the queues that match.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-5"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-6" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="610" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-6"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Charge each payment once&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; payment.py writes the charge, then acknowledges. A crash between the two makes the broker deliver the message again: an idempotent consumer detects the repeated message ID.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-6"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-7" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1"><mxGeometry x="1570" y="720" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-7"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Watch the broker&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The console and its HTTP API show queue depth, consumers and message rates. monitor.py reads the same numbers.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-7"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1570" y="960" width="610" height="90" as="geometry" /></mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Solid arrow: normal message flow.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Dashed arrow: failure path, a message rejected after its last retry.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1570" y="960" width="610" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
