        <mxCell id="e-gacr-fleet2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;startArrow=none;orthogonalLoop=1;exitX=1;exitY=0.67;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="gacr-box" target="fleet2-box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="720" /><mxPoint x="495" y="920" /></Array></mxGeometry></mxCell>
        <mxCell id="badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="258" y="395" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="482" y="322" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1068" y="372" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1372" y="450" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1255" y="545" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="600" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="258" y="600" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="770" y="652" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1600" y="30" width="650" height="1030" as="geometry" /></mxCell>
        <mxCell id="legend-step-1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="60" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-1"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Ask for a match&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The wrapper sends CreateTicket over gRPC with TLS to the standard accelerator on TCP 50504. The ticket carries the player&#x27;s latency to each Region.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-1"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="168" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-2"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Store the ticket&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Global Accelerator forwards to the load balancer of cluster 1. The Open Match Frontend saves the ticket, and the client polls GetTicket until it has an assignment.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-2"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="276" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-3"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Group players by latency&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The Backend runs the Match Function, which reads the waiting tickets through the Query service and proposes matches of four players with similar latency to one Region.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-3"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="384" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-4"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Collect the matches&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Every 5 seconds the Director fetches the matches from the Backend. Each match ID names its Region.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-4"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="492" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-5"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Allocate a game server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The Director asks the Agones allocator of cluster 1 for a server labeled with that Region, over mTLS. A multi-cluster policy lets it forward the request over VPC peering to cluster 2.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-5"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-6" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="600" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-6"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Mark it Allocated&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Agones moves one Ready GameServer of the Fleet to Allocated and returns its private IP and port. The Director maps them to a custom routing port and assigns it to the tickets.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-6"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-7" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="708" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-7"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Race over UDP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The next GetTicket returns the assignment. SuperTuxKart connects over UDP through Global Accelerator custom routing to that game server.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-7"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-step-8" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1620" y="816" width="600" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-8"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-8" value="&lt;div&gt;&lt;b&gt;Recycle the server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; When the race ends the server calls the Agones SDK Shutdown. The Fleet replaces it with a new Ready GameServer, so the pool keeps its size.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-8"><mxGeometry x="52" y="0" width="548" height="100" as="geometry" /></mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1620" y="950" width="610" height="90" as="geometry" /></mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Solid arrow: matchmaking and allocation calls (gRPC over TCP with TLS or mTLS).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Dashed arrow: game traffic over UDP.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1620" y="950" width="610" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
