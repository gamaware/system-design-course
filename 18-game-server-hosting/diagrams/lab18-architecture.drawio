        <mxCell id="e-stk-gacr1-label" value="UDP" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" connectable="0" parent="e-stk-gacr1"><mxGeometry x="0.6" y="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-gacr1-fleet1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;startArrow=none;orthogonalLoop=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gacr1-box" target="fleet1-box"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-gacr1-fleet1-label" value="node ports 7000-7029" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" connectable="0" parent="e-gacr1-fleet1"><mxGeometry x="0.15" y="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-stk-gacr2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;startArrow=none;orthogonalLoop=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stk-box" target="gacr2-box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="864" /><mxPoint x="530" y="1360" /></Array></mxGeometry></mxCell>
        <mxCell id="e-gacr2-fleet2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;startArrow=none;orthogonalLoop=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gacr2-box" target="fleet2-box"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-gacr2-fleet2-label" value="node ports 7000-7029" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" connectable="0" parent="e-gacr2-fleet2"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="458" y="398" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1712" y="552" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1690" y="731" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1618" y="552" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="458" y="494" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="462" y="826" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1152" y="866" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1870" y="30" width="650" height="1470" as="geometry" /></mxCell>
        <mxCell id="legend-step-1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="60" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-1"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Ask for a match&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The Open Match client in the class image sends CreateTicket over gRPC with TLS 1.3 to the standard accelerator on TCP 50504. The Network Load Balancer forwards it to the Open Match Frontend, which stores the ticket with the player&#x27;s latency to each Region. The Frontend does not ask for a client certificate.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-1"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="237" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-2"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Find a match&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Every 5 seconds the Director calls FetchMatches on the Backend. The Backend runs the Match Function, which reads the waiting tickets through the Query service and groups four players with a similar latency to one Region.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-2"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="414" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-3"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Allocate a game server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The Director sends a GameServerAllocation for that Region to the Agones Allocator of cluster 1, over mutual TLS with certificates from cert-manager. A multi-cluster policy can forward it over VPC peering to cluster 2. Agones moves one Ready GameServer of the Fleet to Allocated.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-3"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="591" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-4"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Assign the tickets&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The Director translates the private IP and port of that GameServer to a custom routing address and port, and writes it into the four tickets with AssignTickets.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-4"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="768" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-5"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Read the assignment&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The client polls GetTicket through the same accelerator until its ticket carries the assignment.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-5"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-6" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="945" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-6"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Race over UDP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; SuperTuxKart 1.5 connects over UDP through the custom routing accelerator of that cluster to the allocated GameServer, on ports 7000-7029 of its node. The browser shows the game through noVNC and plays its sound over a WebSocket.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-6"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-step-7" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1890" y="1122" width="600" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-7"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Replace the server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; When the race ends the server calls the Agones SDK Shutdown, and the Fleet creates a new Ready GameServer, so the pool keeps its size.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-7"><mxGeometry x="52" y="0" width="548" height="165" as="geometry" /></mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1890" y="1330" width="610" height="150" as="geometry" /></mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;Line styles and the class image&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Solid arrow: matchmaking and allocation calls (gRPC over TCP, with TLS or mutual TLS).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Dashed arrow: game traffic over UDP.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Dotted arrow: before class (image pull, ECR replication). Thin blue arrow: inside the container.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The instructor builds one class image per deployment. It carries only public data: the Open Match server CA, the Frontend address and the static IPs of the accelerators.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1890" y="1330" width="610" height="150" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
