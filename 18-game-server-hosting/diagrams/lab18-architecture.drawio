        <mxCell id="e-student-gacr-label" value="UDP race" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" vertex="1" connectable="0" parent="e-student-gacr"><mxGeometry x="0.2" y="30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
