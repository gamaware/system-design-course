              <mxPoint x="470" y="845" />
              <mxPoint x="1070" y="845" />
              <mxPoint x="1070" y="682" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-cross-az-label" value="ping across AZs (private IPs)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="edge-cross-az">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step badges -->
        <mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="660" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="968" y="424" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="360" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="470" y="642" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1290" y="30" width="650" height="900" as="geometry" />
        </mxCell>
        <mxCell id="legend-container" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1">
          <mxGeometry x="1310" y="60" width="610" height="840" as="geometry" />
        </mxCell>

        <mxCell id="legend-title" value="How the lab is built, step by step" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=18;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container">
          <mxGeometry width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="50" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-1-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-1-desc" value="&lt;div&gt;&lt;b&gt;CloudFormation deploys the network&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The stack vpc-lab-network creates the VPC 10.0.0.0/16, one public subnet in each Availability Zone, the Internet Gateway and the public route table.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="165" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-2-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-2-desc" value="&lt;div&gt;&lt;b&gt;The AWS CLI adds access and firewall&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The key pair vpc-lab-key and the security group vpc-lab-sg, which allows ICMP, SSH on port 22 from your own IP and HTTP on port 80.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="280" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-3-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-3-desc" value="&lt;div&gt;&lt;b&gt;Terraform launches the instances&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;It reads the stack outputs and starts EC2-1 in subnet A and EC2-2 in subnet C. Both subnets assign a public IP on launch and user-data installs Apache.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="395" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-4-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-4-desc" value="&lt;div&gt;&lt;b&gt;The route table opens the way out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;One route table serves both Availability Zones: it is associated with the two public subnets and sends 0.0.0.0/0 to the Internet Gateway.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="510" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-5-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-5-desc" value="&lt;div&gt;&lt;b&gt;You reach the instances from your computer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;SSH on port 22 and HTTP on port 80 travel through the Internet Gateway to the public IP of each instance.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry y="625" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-6-legend">
          <mxGeometry y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="step-6-desc" value="&lt;div&gt;&lt;b&gt;The instances talk to each other across zones&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;EC2-1 pings EC2-2 on its private IP. That traffic stays inside the VPC and never crosses the Internet Gateway.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend">
          <mxGeometry x="52" width="548" height="100" as="geometry" />
        </mxCell>

        <mxCell id="legend-line-styles" value="" style="rounded=0;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontFamily=Helvetica;container=0;" vertex="1" parent="legend-container">
          <mxGeometry y="745" width="600" height="95" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" value="Line styles" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container">
          <mxGeometry x="16" y="755" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-solid" value="" style="html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#545B64;rounded=0;fontFamily=Helvetica;" edge="1" parent="legend-container">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="790" as="sourcePoint" />
            <mxPoint x="90" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-line-solid-text" value="network traffic between components" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container">
          <mxGeometry x="104" y="780" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-dashed" value="" style="html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;dashed=1;fontFamily=Helvetica;" edge="1" parent="legend-container">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="820" as="sourcePoint" />
            <mxPoint x="90" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-line-dashed-text" value="what each tool creates, and the route it configures" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container">
          <mxGeometry x="104" y="810" width="480" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
