        </mxCell>
        <mxCell id="legend-step-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-1-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-desc" value="&lt;div&gt;&lt;b&gt;Upload one object&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;mc or the aws CLI sends a single PUT to port 9000&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The client knows nothing about drives or shards&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-1-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="106" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-2-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-desc" value="&lt;div&gt;&lt;b&gt;MinIO splits it into four shards&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Two shards carry content and two carry recovery information, and MinIO decides per object which drive holds which&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;One shard per drive, so no single drive has a fixed role&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-2-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="192" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-3-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" value="&lt;div&gt;&lt;b&gt;A drive is lost&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The lab empties /data3 to simulate a failed disk&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;With EC:2 the object tolerates up to two lost drives&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-3-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="278" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-4-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-desc" value="&lt;div&gt;&lt;b&gt;MinIO reads the survivors&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Three of the four shards are enough to rebuild the object&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The read succeeds without any manual restore step&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-4-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="364" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-5-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-desc" value="&lt;div&gt;&lt;b&gt;The client gets the whole object&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The GET returns the original bytes and a 200 response&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Parity costs about 100 percent overhead: the object occupies 2x its size, against 3x for three-way replication&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-5-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="21" y="460" width="598" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-bg" value="" style="fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="0" y="0" width="598" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" value="Line styles" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="10" y="8" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-desc" value="&lt;div&gt;&lt;b&gt;Solid&lt;/b&gt;: the write path that places the shards&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dashed&lt;/b&gt;: the recovery read that rebuilds the object&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="10" y="34" width="576" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
