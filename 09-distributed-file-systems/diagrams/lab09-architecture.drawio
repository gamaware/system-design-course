        <mxCell id="legend-step-1-desc" value="&lt;div&gt;&lt;b&gt;Driving the lab from the terminal&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The student runs every command inside the containers with docker exec or docker compose run&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;No tool is installed on the host beyond Docker Desktop&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-1-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="106" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-2-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-desc" value="&lt;div&gt;&lt;b&gt;Clients mount the exports&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;nfs-client-1 and nfs-client-2 mount the same three exports under /mnt/shared, /mnt/data and /mnt/backup&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The mount is transparent: applications read and write local paths&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-2-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="192" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-3-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" value="&lt;div&gt;&lt;b&gt;The server exports three directories&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;/nfs/shared and /nfs/data are exported read-write, /nfs/backup read-only&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Each export is a named Docker volume on the server&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-3-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
