          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" value="&lt;div&gt;&lt;b&gt;The server commits to disk&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The export uses sync, so the server writes to its volume first&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Only then does it acknowledge the write to the client&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-3-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="278" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-4-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-desc" value="&lt;div&gt;&lt;b&gt;The other client reads&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;nfs-client-2 reads the same path from its own mount&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;It never talks to nfs-client-1, only to the server&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-4-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="364" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-5-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-desc" value="&lt;div&gt;&lt;b&gt;Both clients see the same bytes&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The server is the single source of truth, so the read is consistent&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;This POSIX guarantee is what object storage does not offer&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-5-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="20" y="450" width="600" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="legend-step-6-group" vertex="1">
          <mxGeometry x="0" y="2" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-desc" value="&lt;div&gt;&lt;b&gt;flock serializes writers&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;nfs-client-1 takes an advisory lock on /mnt/data/lockfile.lock&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;flock -n from nfs-client-2 is denied while the lock is held&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-step-6-group" vertex="1">
          <mxGeometry x="52" y="0" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-group" value="" style="group;fontFamily=Helvetica;" parent="legend-outer" vertex="1" connectable="0">
          <mxGeometry x="21" y="546" width="598" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-bg" value="" style="fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="0" y="0" width="598" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" value="Line styles" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="10" y="8" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-desc" value="&lt;div&gt;&lt;b&gt;Solid&lt;/b&gt;: requests the client sends&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dashed&lt;/b&gt;: what comes back, including the denied lock&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="legend-line-group" vertex="1">
          <mxGeometry x="10" y="34" width="576" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
