          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="b-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="app-b" target="cache-b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="b-e3-label" value="GET product:1  (HIT ~1 ms)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=light-dark(#232F3E,#F5F5F5);fontFamily=Helvetica;" connectable="0" vertex="1" parent="b-e3">
          <mxGeometry x="0.0" relative="1" as="geometry">
            <mxPoint x="0" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=none;dashed=1;dashPattern=6 6;" edge="1" parent="1" source="app-b" target="origin-b">
