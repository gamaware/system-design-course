        <mxCell id="subtitle-text" value="Every write reaches the origin and the cache before the call returns, so no read can observe a stale value" style="text;html=1;resizable=0;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group">
