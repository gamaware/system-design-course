        <mxCell id="legend-title" value="&lt;b&gt;OAuth 2.0 password grant flow, driven from curl&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#FFFFFF);" vertex="1" parent="legend-container">
