        <mxCell id="badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="175" y="283" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="205" y="495" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="436" y="238" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="950" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1430" y="440" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="650" height="1020" as="geometry" /></mxCell>
        <mxCell id="legend-step-1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="60" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-1"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Run a first container&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; docker run starts nginx in its own namespaces, limited by cgroups to 64 MiB and half a CPU. On the host it is one more process.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-1"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="180" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-2"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Build a small image&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; A multi-stage build compiles Go in a throwaway stage and copies only the binary onto distroless: about 15 MB, non-root, with a health check.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-2"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="300" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-3"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Push it to a registry&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; docker push uploads the layers and the manifest to lab17-registry. Every pull of that tag returns the same digest.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-3"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="420" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-4"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Declare the desired state&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; kubectl sends the Deployment and the Service to kube-apiserver, which stores them in etcd.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-4"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="540" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-5"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Schedule and pull&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The scheduler assigns each pod to a worker. The kubelet of that node pulls localhost:5001/lab17-web from the registry, which joined the kind network.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-5"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-6" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="660" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-6"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Reach the pods&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; 127.0.0.1:30080 lands on the NodePort of the control plane node. kube-proxy sends each connection to one ready pod on either worker.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-6"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-step-7" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1" connectable="0"><mxGeometry x="1580" y="780" width="600" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="legend-step-7"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Heal, scale, roll out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Controllers compare the desired state with the actual one: they replace a deleted pod, evict the pods of a stopped node, add replicas and swap v1 for v2 one pod at a time.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-step-7"><mxGeometry x="52" y="0" width="548" height="110" as="geometry" /></mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;fillStyle=auto;" vertex="1" parent="1"><mxGeometry x="1580" y="940" width="610" height="90" as="geometry" /></mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Solid arrow: a command or a request.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Dashed arrow: image layers moving to or from the registry.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1580" y="940" width="610" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
