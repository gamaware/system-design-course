        <mxCell id="step-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="4" vertex="1">
          <mxGeometry height="28" width="28" x="975" y="535" as="geometry" />
        </mxCell>
        <mxCell id="step-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="5" vertex="1">
          <mxGeometry height="28" width="28" x="1160" y="308" as="geometry" />
        </mxCell>
        <mxCell id="step-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="6" vertex="1">
          <mxGeometry height="28" width="28" x="820" y="560" as="geometry" />
        </mxCell>
        <mxCell id="step-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="7" vertex="1">
          <mxGeometry height="28" width="28" x="1100" y="800" as="geometry" />
        </mxCell>
        <mxCell id="legend-outer" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="990" width="650" x="1520" y="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" parent="legend-outer" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1">
          <mxGeometry height="990" width="650" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-badge" parent="legend-step-1-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-desc" parent="legend-step-1-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The wizard creates the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;One VPC on 172.16.0.0/16 in a single Availability Zone&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;One public and one private subnet, each with its own route table&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-badge" parent="legend-step-2-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-desc" parent="legend-step-2-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;An internet gateway is attached&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;It belongs to the VPC, not to a subnet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;It carries traffic only for subnets whose table points at it&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-badge" parent="legend-step-3-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" parent="legend-step-3-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The instance gets one interface&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The elastic network interface is what the system calls eth0&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;It holds a private address, plus the public one you enable at launch&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="320" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-badge" parent="legend-step-4-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-desc" parent="legend-step-4-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The security group guards the instance&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Only SSH on port 22 from your own address is allowed in&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;This is the firewall layer the Docker lab did not have&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="420" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-badge" parent="legend-step-5-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-desc" parent="legend-step-5-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The public route table makes the subnet public&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A local route covers 172.16.0.0/16 inside the VPC&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;A 0.0.0.0/0 entry sends everything else to the internet gateway&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-badge" parent="legend-step-6-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-desc" parent="legend-step-6-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The VPC router is the default gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Inside the instance, ip r shows default via the first address of the subnet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;AWS set that route for you, which is the step you ran by hand on Docker&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="620" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7-badge" parent="legend-step-7-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7-desc" parent="legend-step-7-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The private subnet has no way out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Its table keeps only the local route, and this lab adds no NAT gateway&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;That missing default entry is the same gap as the broken Docker server&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-note" parent="legend-outer" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=2;" value="&lt;i&gt;The private route table has no outgoing arrow on purpose: with no NAT gateway there is nothing for it to point to.&lt;/i&gt;" vertex="1">
          <mxGeometry height="50" width="600" x="20" y="730" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="170" width="600" x="20" y="790" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-bg" parent="legend-line-group" style="fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="170" width="600" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-title" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;fontStyle=1;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="How this maps to the Docker lab" vertex="1">
          <mxGeometry height="26" width="400" x="10" y="8" as="geometry" />
        </mxCell>
        <mxCell id="legend-line-desc" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Elastic network interface&lt;/b&gt; is the eth0 you inspected with ip a&lt;/div&gt;&lt;div&gt;&lt;b&gt;Route table&lt;/b&gt; is what ip r prints&lt;/div&gt;&lt;div&gt;&lt;b&gt;VPC router&lt;/b&gt; is the default gateway you added by hand&lt;/div&gt;&lt;div&gt;&lt;b&gt;Public and private subnets&lt;/b&gt; play the part of the frontend and backend networks&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Arrows with two heads carry traffic both ways.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="570" x="10" y="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
