        <mxCell id="legend-step-1-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-badge" parent="legend-step-1-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-desc" parent="legend-step-1-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Two interfaces on Bob's laptop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;eth0 on the frontend network, eth1 on the backend network&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;ip a and ip link show both addresses and both in state UP&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-badge" parent="legend-step-2-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-desc" parent="legend-step-2-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The frontend path fails&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The name devapp01-web resolves to 172.16.238.20&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;ping, telnet on port 80 and curl all get no reply&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-badge" parent="legend-step-3-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-desc" parent="legend-step-3-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The backend path answers&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;ping 172.16.239.20 succeeds, so the server itself is running&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The second interface is the redundant way in&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="320" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-badge" parent="legend-step-4-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-desc" parent="legend-step-4-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Reach the server over the backend network&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;SSH to the backend address, or attach to the container directly&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;From inside, ip link and ip r expose both faults&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="420" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-badge" parent="legend-step-5-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-desc" parent="legend-step-5-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Fault 1: the frontend interface is down&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The interface holding 172.16.238.20 reports state DOWN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;That is why devapp01-web answers nothing on the frontend network&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-group" connectable="0" parent="legend-outer" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="600" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-badge" parent="legend-step-6-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-desc" parent="legend-step-6-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Fault 2: the default route is missing&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The server keeps its two connected routes but has no default entry&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Without it the bridge gateway is never used and nothing off-subnet is reachable&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-note" parent="legend-outer" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=2;" value="&lt;i&gt;Red containers and red dashed arrows mark the two faults the lab introduces on purpose. Nothing here is drawn in its repaired state.&lt;/i&gt;" vertex="1">
          <mxGeometry height="50" width="600" x="20" y="625" as="geometry" />
        </mxCell>
