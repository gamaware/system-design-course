        <mxCell id="legend-line-desc" parent="legend-line-group" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Green solid&lt;/b&gt;: path that works from the first minute of the lab&lt;/div&gt;&lt;div&gt;&lt;b&gt;Red dashed&lt;/b&gt;: path broken on purpose, to be diagnosed&lt;/div&gt;&lt;div&gt;&lt;b&gt;Grey solid&lt;/b&gt;: the interface belongs to that container&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Green and blue network bands are the two Docker bridge networks, the same split the optional AWS section mirrors with a public and a private subnet.&lt;/i&gt;&lt;/div&gt;" vertex="1">
