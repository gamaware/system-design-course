  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} es el proxy HTTP que recibe las apuestas por HTTPS, las reparte entre los contenedores y le pasa a la API la IP del jugador en el encabezado X-Forwarded-For."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} corre la API en contenedores sin que el equipo de dos personas administre servidores, nodos ni un clúster de Kubernetes."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} guarda en memoria la tabla de posiciones de 2 millones de jugadores, ordenada por puntos, para no ir a la base de datos en cada consulta."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} absorbe el pico del minuto 90: los trabajadores sacan las apuestas a su ritmo y cada una se da por terminada solo cuando confirman que la procesaron; si no, se vuelve a entregar."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} es la base de datos NoSQL de las apuestas: guarda cada una con clave por jugador y partido y solo la escribe si esa clave no existe, para que nadie apueste dos veces."
    },
    {
      "n": 6,
      "slot": null,
      "text": "El proveedor de marcadores manda cada gol a la API del slot 2, que actualiza la tabla de posiciones del slot 3."
    }
  ],
  "palette": [
    {
      "service": "azure-app-gateway"
    },
    {
      "service": "azure-container-apps"
