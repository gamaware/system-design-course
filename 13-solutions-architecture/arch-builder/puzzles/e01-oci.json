        "r": 2.5
      },
      "group": "g-net",
      "accept": [
        "oci-network-firewall"
      ],
      "near_miss": "oci-security-list",
      "hint_cue": "solo deja llegar a los dominios",
      "explanation": "OCI Network Firewall filtra por URL y FQDN: puede restringir el tráfico de salida a una lista de dominios, como los del SAT, el banco y los parches.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/network-firewall/overview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Network/Concepts/securityrules.htm"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 4.28,
        "r": 3.85
      },
      "group": "g-db",
      "accept": [
        "oci-nsg"
      ],
      "near_miss": "oci-security-list",
      "hint_cue": "estén en la subred que estén",
      "explanation": "Un NSG se aplica solo a las VNIC que eliges y su regla puede usar otro NSG como origen, así que el 3306 se abre a los servidores de la app sin depender de su subred; con reglas con estado, la respuesta pasa sola.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Network/Concepts/securityrules.htm"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 2.2,
        "r": 5.15
      },
      "group": "g-region",
      "accept": [
        "oci-bastion"
      ],
      "near_miss": "oci-site-to-site-vpn",
      "hint_cue": "sin abrir el puerto 22 a internet",
      "explanation": "OCI Bastion da acceso restringido y por tiempo limitado, con sesiones SSH, a recursos sin endpoint público, y Audit registra cada llamada a la API de Bastion, como la que crea una sesión.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Bastion/Concepts/bastionoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Network/Tasks/managingIPsec.htm"
      ]
    },
