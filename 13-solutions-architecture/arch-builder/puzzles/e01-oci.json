  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} deja que los servidores privados descarguen parches de internet, pero nadie de afuera puede abrirles una conexión."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "Todo el tráfico web de salida pasa por {{s2}}, un intermediario que solo deja llegar a los dominios del SAT, del banco y del repositorio de parches."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} hace que solo los servidores de la app hablen con la BD por el puerto 3306, estén en la subred que estén, y que la respuesta regrese sola."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} da a los administradores una terminal en servidores sin IP pública, sin abrir el puerto 22 a internet, y deja registro de cada sesión."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} lleva las boletas PDF de los servidores al almacenamiento de objetos sin salir a internet ni pasar por el slot 1."
    },
    {
      "n": 6,
      "slot": "s6",
      "text": "{{s6}} guarda el origen, el destino y el puerto del tráfico de red de los servidores para investigar un escaneo."
    },
    {
      "n": 7,
      "slot": null,
      "text": "La base de datos de calificaciones escucha en el puerto 3306 y vive en una subred privada, sin IP pública."
    }
  ],
  "palette": [
    {
      "service": "oci-nat-gateway"
    },
    {
      "service": "oci-network-firewall"
    },
    {
      "service": "oci-nsg"
    },
    {
      "service": "oci-bastion"
    },
    {
      "service": "oci-service-gateway"
    },
    {
      "service": "oci-vcn-flow-logs"
    },
    {
      "service": "oci-internet-gateway",
      "role": "near-miss",
      "why_not": {
        "s1": "Con un internet gateway, las instancias de una subred pública inician conexiones a internet y también reciben conexiones de entrada desde internet."
      }
    },
    {
      "service": "oci-security-list",
      "role": "near-miss",
      "why_not": {
        "s2": "Una security list aplica reglas de IP, protocolo y puerto a todas las VNIC de una subred; no filtra por nombre de dominio.",
        "s3": "Una security list aplica sus reglas a todas las VNIC de la subred completa; Oracle recomienda NSG para separar la seguridad de la app de la forma de las subredes."
      }
    },
    {
      "service": "oci-site-to-site-vpn",
      "role": "near-miss",
      "why_not": {
        "s4": "Site-to-Site VPN es una conexión IPSec entre la red local y la VCN; no son las sesiones SSH con acceso restringido y por tiempo limitado que da Bastion, cuya creación queda registrada en Audit."
      }
    },
    {
      "service": "oci-lpg",
      "role": "near-miss",
      "why_not": {
        "s5": "Un local peering gateway conecta dos VCN de la misma región para que sus recursos se comuniquen con IP privadas; el acceso privado a Object Storage lo da el service gateway. Oracle recomienda enrutar entre VCN con un DRG actualizado."
      }
    },
    {
      "service": "oci-audit",
      "role": "near-miss",
      "why_not": {
        "s6": "Audit registra llamadas a las APIs públicas, como las de Bastion; no guarda el tráfico de red entre las VNIC."
      }
    }
  ],
  "review_notes": "Escenario 1 de ARCHITECTURES.md. Querétaro tiene un solo AD, así que las columnas son dominios de falla. La security list es el near-miss de los slots 2 y 3, como en la tabla. El Local Peering Gateway sigue soportado, pero Oracle recomienda un DRG actualizado.",
  "status": "published"
}
