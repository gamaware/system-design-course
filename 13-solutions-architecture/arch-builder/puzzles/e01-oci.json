      "cell": {
        "c": 6.6,
        "r": 3.85
      },
      "group": "g-net",
      "accept": [
        "oci-service-gateway"
      ],
      "near_miss": "oci-lpg",
      "hint_cue": "sin salir a internet ni pasar por el slot 1",
      "explanation": "El service gateway deja que la VCN llegue en privado a servicios de Oracle como Object Storage, sin internet gateway ni NAT gateway; el tráfico va por la red de Oracle y nunca cruza internet.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Network/Tasks/servicegateway.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Network/Tasks/localVCNpeering.htm"
