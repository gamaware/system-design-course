        "r": 2.5
      },
      "group": "g-net",
      "accept": [
        "aws-network-firewall"
      ],
      "near_miss": "aws-dns-firewall",
      "hint_cue": "solo deja llegar a los dominios",
      "explanation": "Con un grupo de reglas de lista de dominios, Network Firewall deja pasar solo los dominios permitidos: lee el SNI en HTTPS y el encabezado Host en HTTP, y niega el resto del tráfico de ese protocolo.",
      "refs": [
        "https://docs.aws.amazon.com/network-firewall/latest/developerguide/stateful-rule-groups-domain-names.html",
        "https://docs.aws.amazon.com/Route53/latest/DeveloperGuide/resolver-dns-firewall-overview.html"
      ]
    },
