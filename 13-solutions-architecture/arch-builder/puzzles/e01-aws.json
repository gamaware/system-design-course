  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} deja que los servidores privados descarguen parches de internet, pero nadie de afuera puede abrirles una conexión."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "Todo el tráfico web de salida pasa por {{s2}}, un intermediario que solo deja llegar a los dominios del SAT, del banco y del repositorio de parches."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} hace que solo los servidores de la app hablen con la BD por el puerto 3306, estén en la subred que estén, y que la respuesta regrese sola."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} da a los administradores una terminal en servidores sin IP pública, sin abrir el puerto 22 a internet, y deja registro de cada sesión."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} lleva las boletas PDF de los servidores al almacenamiento de objetos sin salir a internet ni pasar por el slot 1."
    },
    {
      "n": 6,
      "slot": "s6",
      "text": "{{s6}} guarda el origen, el destino y el puerto del tráfico de red de los servidores para investigar un escaneo."
    },
    {
      "n": 7,
      "slot": null,
      "text": "La base de datos de calificaciones escucha en el puerto 3306 y vive en una subred privada, sin IP pública."
    }
  ],
  "palette": [
    {
      "service": "aws-nat-gateway"
    },
    {
      "service": "aws-network-firewall"
    },
    {
      "service": "aws-security-group"
    },
    {
      "service": "aws-session-manager"
    },
    {
      "service": "aws-vpc-endpoint"
    },
    {
      "service": "aws-vpc-flow-logs"
    },
    {
      "service": "aws-internet-gateway",
      "role": "near-miss",
      "why_not": {
        "s1": "Un internet gateway deja que los recursos con IP pública se conecten a internet, pero también deja que los recursos de internet inicien una conexión con ellos."
      }
    },
    {
      "service": "aws-dns-firewall",
      "role": "near-miss",
      "why_not": {
        "s2": "DNS Firewall solo filtra por nombre de dominio la consulta DNS que pasa por el Resolver; no filtra protocolos de aplicación como HTTPS, así que el tráfico web no pasa por él."
      }
    },
    {
      "service": "aws-network-acl",
      "role": "near-miss",
      "why_not": {
        "s3": "Una network ACL se aplica a toda la subred y no guarda estado: la respuesta tiene que permitirse con una regla explícita."
      }
    },
    {
      "service": "aws-client-vpn",
      "role": "near-miss",
      "why_not": {
        "s4": "Client VPN da acceso a los recursos de AWS desde el equipo del usuario, y su registro anota cuándo un cliente se conecta, lo intenta o se desconecta del endpoint. La terminal sin puertos de entrada ni llaves SSH es lo que da Session Manager."
      }
    },
    {
      "service": "aws-vpc-peering",
      "role": "near-miss",
      "why_not": {
        "s5": "Un VPC peering es una conexión de red entre dos VPC para enrutar tráfico con IP privadas, no un acceso a S3. Además, los recursos del otro lado de un peering no pueden usar un gateway endpoint para llegar a S3."
      }
    },
    {
      "service": "aws-cloudtrail",
      "role": "near-miss",
      "why_not": {
        "s6": "CloudTrail registra llamadas a la API, como las de Session Manager; no guarda el origen, el destino ni el puerto del tráfico de red."
      }
    }
  ],
  "review_notes": "Escenario 1 de ARCHITECTURES.md. Zonas como columnas que cruzan las subredes. Simplificación: en AWS el NAT gateway público vive en la subred pública y sale por el internet gateway; aquí se dibuja dentro de la VPC, fuera de las subredes, para compartir la topología con las otras nubes. El firewall también se dibuja sin su subred propia.",
  "status": "published"
}
