  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 2.65,
        "r": 2.48
      },
      "group": "g-priv-mx",
      "accept": [
        "azure-mysql-flex-ha"
      ],
      "near_miss": "azure-sql-database",
      "hint_cue": "toma el control sola",
      "explanation": "Con HA con redundancia de zona, Flexible Server mantiene un standby en otra zona de la misma región; si la primaria deja de estar disponible, el standby se vuelve la primaria. El standby no atiende lecturas ni escrituras.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-high-availability",
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-read-replicas",
        "https://learn.microsoft.com/en-us/azure/azure-sql/database/active-geo-replication-overview"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 4.45,
        "r": 2.48
      },
      "group": "g-priv-mx",
      "accept": [
        "azure-mysql-read-replica"
      ],
      "near_miss": null,
      "hint_cue": "una copia aparte",
      "explanation": "La réplica de lectura de Flexible Server usa replicación asíncrona, con un retraso medible, y sirve como origen de los reportes; así la primaria solo atiende las escrituras.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-read-replicas",
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-high-availability"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 1.3,
        "r": 4.3
      },
      "group": "g-cloud",
      "accept": [
        "azure-cosmos-db"
      ],
      "near_miss": "azure-sql-database",
      "hint_cue": "ambas aceptan escrituras",
      "explanation": "Con escrituras multirregión, Cosmos DB confirma cada escritura en la región local y la replica a las demás en forma asíncrona; por eso esa configuración no admite consistencia fuerte.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/cosmos-db/multi-region-writes",
        "https://learn.microsoft.com/en-us/azure/azure-sql/database/active-geo-replication-overview"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 5.7,
        "r": 2.48
      },
      "group": "g-region-mx",
      "accept": [
        "azure-monitor"
      ],
      "near_miss": "azure-activity-log",
      "hint_cue": "se atrasa más de 30 segundos",
      "explanation": "Flexible Server publica la métrica Replication Lag In Seconds y la guía de réplicas recomienda una alerta para cuando el retraso pase del umbral; una alerta de métricas de Azure Monitor hace ese aviso.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-monitoring",
        "https://learn.microsoft.com/en-us/azure/mysql/flexible-server/concepts-read-replicas",
        "https://learn.microsoft.com/en-us/azure/azure-monitor/fundamentals/activity-log"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 0.15,
        "r": 2.48
      },
      "group": "g-region-mx",
      "accept": [
        "azure-key-vault-secrets"
      ],
      "near_miss": "azure-app-configuration",
      "hint_cue": "antes de que la contraseña venza",
      "explanation": "Key Vault guarda la contraseña como secreto que la app lee. Treinta días antes de que venza, Key Vault publica el evento de vencimiento próximo en Event Grid y una función propia la cambia; la vigencia va en la etiqueta ValidityPeriodDays.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/key-vault/secrets/tutorial-rotation",
        "https://learn.microsoft.com/en-us/azure/azure-app-configuration/overview"
      ]
    }
  ],
