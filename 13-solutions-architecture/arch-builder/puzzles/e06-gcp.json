  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 2.65,
        "r": 2.48
      },
      "group": "g-priv-mx",
      "accept": [
        "gcp-cloud-sql-ha"
      ],
      "near_miss": "gcp-spanner",
      "hint_cue": "toma el control sola",
      "explanation": "Cloud SQL con HA tiene una zona primaria y otra secundaria en la región; la replicación síncrona copia cada escritura a los discos de ambas zonas y, si la primaria falla, Cloud SQL pasa solo al standby.",
      "refs": [
        "https://docs.cloud.google.com/sql/docs/mysql/high-availability",
        "https://docs.cloud.google.com/sql/docs/mysql/replication",
        "https://docs.cloud.google.com/spanner/docs/true-time-external-consistency"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 4.45,
        "r": 2.48
      },
      "group": "g-priv-mx",
      "accept": [
        "gcp-cloud-sql-replica"
      ],
      "near_miss": null,
      "hint_cue": "una copia aparte",
      "explanation": "Una réplica de lectura de Cloud SQL es de solo lectura, se actualiza casi en tiempo real y atiende consultas y análisis, así baja la carga de la primaria.",
      "refs": [
        "https://docs.cloud.google.com/sql/docs/mysql/replication",
        "https://docs.cloud.google.com/sql/docs/mysql/high-availability",
        "https://docs.cloud.google.com/spanner/docs/true-time-external-consistency"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 1.3,
        "r": 4.3
      },
      "group": "g-cloud",
      "accept": [
        "gcp-bigtable"
      ],
      "near_miss": "gcp-spanner",
      "hint_cue": "ambas aceptan escrituras",
      "explanation": "Bigtable está en northamerica-south1 y us-south1, replica entre clústeres de hasta 8 regiones y deja leer y escribir en cada uno; con enrutamiento multiclúster va al clúster más cercano, y por defecto la replicación es eventualmente consistente.",
      "refs": [
        "https://docs.cloud.google.com/bigtable/docs/replication-overview",
        "https://docs.cloud.google.com/spanner/docs/true-time-external-consistency",
        "https://docs.cloud.google.com/bigtable/docs/locations"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 5.7,
        "r": 2.48
      },
      "group": "g-region-mx",
      "accept": [
        "gcp-cloud-monitoring"
      ],
      "near_miss": "gcp-audit-logs",
      "hint_cue": "se atrasa más de 30 segundos",
      "explanation": "Cloud SQL mide el retraso con la métrica replica_lag, en segundos; una política de alertas de Cloud Monitoring con condición de umbral sobre esa métrica avisa al equipo cuando pasa de 30 segundos.",
      "refs": [
        "https://docs.cloud.google.com/sql/docs/mysql/replication/replication-lag",
        "https://docs.cloud.google.com/monitoring/alerts",
        "https://docs.cloud.google.com/logging/docs/audit"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 0.15,
        "r": 2.48
      },
      "group": "g-region-mx",
      "accept": [
        "gcp-secret-manager"
      ],
      "near_miss": "gcp-parameter-manager",
      "hint_cue": "avisa cada 30 días",
      "explanation": "Secret Manager guarda la contraseña como secreto; con un periodo de rotación manda el mensaje SECRET_ROTATE a Pub/Sub, y tu suscriptor es quien la cambia. Secret Manager no la rota por sí mismo.",
      "refs": [
        "https://docs.cloud.google.com/secret-manager/docs/secret-rotation",
        "https://docs.cloud.google.com/secret-manager/docs/release-notes",
        "https://docs.cloud.google.com/secret-manager/parameter-manager/docs/overview"
      ]
    }
  ],
