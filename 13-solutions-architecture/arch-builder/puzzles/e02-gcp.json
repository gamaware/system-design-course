  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} es cada servidor individual: tiene su propio sistema operativo que el equipo parcha, su agente de inventario instalado y atiende todo el día."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} mantiene de 2 a 20 copias en ambas zonas, agrega o quita según la carga y reemplaza las que fallan."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} recibe y descifra el HTTPS, manda /api a un grupo y /tienda a otro, y solo envía a servidores sanos."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} emite y renueva automáticamente lo que el slot 3 presenta al navegador para probar que es tienda.mx."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} registra la CPU cada minuto y avisa a guardia si pasa de 80 % durante 5 minutos."
    },
    {
      "n": 6,
      "slot": null,
      "text": "La base de datos administrada guarda pedidos e inventario, y solo la consultan los servidores del slot 1."
    }
  ],
