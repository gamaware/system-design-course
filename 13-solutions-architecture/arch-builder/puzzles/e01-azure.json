  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} deja que los servidores privados descarguen parches de internet, pero nadie de afuera puede abrirles una conexión."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "Todo el tráfico web de salida pasa por {{s2}}, un intermediario que solo deja llegar a los dominios del SAT, del banco y del repositorio de parches."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} se asocia a la subred de la BD y sus reglas solo dejan entrar por el puerto 3306 a los servidores de la app; la respuesta regresa sola, sin otra regla."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} da a los administradores una terminal en servidores sin IP pública, sin abrir el puerto 22 a internet, y deja registro de cada sesión."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} lleva las boletas PDF de los servidores al almacenamiento de objetos sin salir a internet ni pasar por el slot 1."
    },
    {
      "n": 6,
      "slot": "s6",
      "text": "{{s6}} guarda el origen, el destino y el puerto del tráfico de red de los servidores para investigar un escaneo."
    },
    {
      "n": 7,
      "slot": null,
      "text": "La base de datos de calificaciones escucha en el puerto 3306 y vive en una subred privada, sin IP pública."
    }
  ],
  "palette": [
    {
      "service": "azure-nat-gateway"
    },
    {
      "service": "azure-firewall"
    },
    {
      "service": "azure-nsg",
      "why_not": {
        "s2": "Las reglas de un NSG usan direcciones IP, rangos CIDR, etiquetas de servicio o application security groups; no pueden limitar la salida a nombres de dominio."
      }
    },
    {
      "service": "azure-bastion"
    },
    {
      "service": "azure-private-endpoint"
    },
    {
      "service": "azure-vnet-flow-logs"
    },
    {
      "service": "azure-public-ip",
      "role": "near-miss",
      "why_not": {
        "s1": "Una IP pública en la VM es otra forma de salida, pero le da a la VM una dirección en internet. Además, NAT Gateway tiene prioridad sobre las IP públicas de las instancias."
      }
    },
    {
      "service": "azure-asg",
      "role": "near-miss",
      "why_not": {
        "s3": "Un application security group solo agrupa las interfaces de red de las VM; las reglas que permiten o niegan el tráfico viven en el NSG asociado a la subred, que usa el grupo como origen o destino."
      }
    },
    {
      "service": "azure-vpn-gateway",
      "role": "near-miss",
      "why_not": {
        "s4": "Una VPN punto a sitio crea una conexión segura de una computadora a la red virtual; no es la conexión RDP o SSH por TLS hacia cada VM que da Bastion, que con el SKU Premium graba cada sesión."
      }
    },
    {
      "service": "azure-vnet-peering",
      "role": "near-miss",
      "why_not": {
        "s5": "El peering conecta dos o más redes virtuales para que sus recursos se comuniquen; la IP privada de la VNet para la cuenta de almacenamiento la da el private endpoint."
      }
    },
    {
      "service": "azure-activity-log",
      "role": "near-miss",
      "why_not": {
        "s6": "El registro de actividad guarda operaciones de administración sobre los recursos, como crear una VM o cambiar una política de acceso; el origen, el destino y el puerto de cada flujo los registran los flow logs de red virtual."
      }
    }
  ],
  "review_notes": "Escenario 1 de ARCHITECTURES.md. Azure no tiene internet gateway como recurso; el distractor del slot 1 es la IP pública en la VM. El slot 2 no tiene near-miss propio: la confusión es con el NSG, que es la respuesta del slot 3 y lleva why_not para s2. El requisito 3 pide asociarse a la subred de la BD y no menciona la subred de los servidores: así el application security group, que solo agrupa VM, no es segunda respuesta. Simplificación: Azure Bastion se despliega dentro de la VNet (AzureBastionSubnet); aquí se dibuja a nivel de región para compartir la topología.",
  "status": "published"
}
