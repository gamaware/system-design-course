  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} guarda los pagos en MySQL administrado sin sacarlos de México, con una copia en otro dominio de falla que toma el control sola si cae la primaria."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} da a los reportes una copia aparte de la primaria del slot 1 para no frenarla, aunque lleve segundos de retraso."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} guarda los favoritos: cada país escribe en milisegundos en su región y ambas aceptan escrituras. La otra región los ve después, porque se prefiere disponibilidad a consistencia."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} avisa al equipo de reportes si la copia del slot 2 se atrasa más de 30 segundos respecto a la primaria."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} guarda la contraseña de la BD fuera del código: la app la pide al arrancar y una rotación programada cada 30 días, con una función propia como destino, la cambia."
    },
    {
      "n": 6,
      "slot": null,
      "text": "El MySQL del restaurante piloto corre en su propio local; sus pagos se migran al slot 1 antes de abrir a los 2 mil restaurantes."
    }
  ],
  "palette": [
    {
      "service": "oci-mysql-ha",
      "why_not": {
        "s2": "En HA solo la primaria da acceso de lectura y escritura; las secundarias no atienden los reportes."
      }
    },
    {
      "service": "oci-mysql-read-replica",
      "why_not": {
        "s1": "Una réplica de lectura es una copia de solo lectura que se actualiza en forma asíncrona para repartir lecturas; la que toma el lugar de la primaria es una secundaria de HA."
      }
    },
    {
      "service": "oci-nosql"
    },
    {
      "service": "oci-monitoring"
    },
    {
      "service": "oci-vault-secrets"
    },
    {
      "service": "oci-autonomous-db",
      "role": "near-miss",
      "why_not": {
        "s1": "Autonomous AI Database no es un sistema MySQL: Data Guard le crea un standby que se actualiza con los cambios de la primaria, pero los pagos necesitan MySQL administrado.",
        "s2": "Autonomous AI Database con Data Guard es otra base de datos; no es una copia del MySQL del slot 1.",
        "s3": "Con Autonomous Data Guard el standby se actualiza continuamente con los cambios de la primaria: las escrituras llegan por la primaria, no por las dos regiones."
      }
    },
    {
      "service": "oci-audit",
      "role": "near-miss",
      "why_not": {
        "s4": "Audit registra como eventos las llamadas a las API públicas de OCI; el retraso de la réplica es una métrica, y las alarmas sobre métricas son de Monitoring."
      }
    },
    {
      "service": "oci-object-storage",
      "role": "near-miss",
      "why_not": {
        "s5": "Object Storage guarda objetos dentro de buckets; la rotación programada con intervalo y sistema destino que describe la guía de OCI Vault es una opción de los secretos de Vault."
      }
    },
    {
      "service": "oci-network-load-balancer",
      "role": "filler"
    }
  ],
  "review_notes": "Tabla del Escenario 6 de ARCHITECTURES.md. Regiones apiladas: México arriba y EE. UU. abajo; el slot 3 queda entre las dos, a nivel de nube. La réplica de lectura (distractor del slot 1) y el standby de HA (distractor del slot 2) son respuestas de otro slot, así que su why_not va en la ficha de respuesta. Sin rotación nativa en Azure, GCP y OCI (E6-5): la explicación dice que la rotación necesita código propio. La tabla de métricas de HeatWave no lista el nombre de la métrica de retraso de réplica; la guía de réplicas sí dice que existe y que admite alarmas. La ficha de relleno es un balanceador.",
  "status": "published"
}
