      }
    },
    {
      "service": "oci-instance-configuration",
      "role": "near-miss",
      "why_not": {
        "s2": "Una instance configuration es la plantilla para crear instancias: no mantiene copias ni escala con la carga."
      }
    },
    {
      "service": "oci-network-load-balancer",
      "role": "near-miss",
      "why_not": {
        "s3": "OCI Network Load Balancer trabaja en capa 3 y 4: pasa los paquetes sin descifrar el HTTPS ni leer la URL."
      }
    },
    {
      "service": "oci-vault",
      "role": "near-miss",
      "why_not": {
        "s4": "Una llave de OCI Vault tiene versiones y sirve para cifrar o firmar, pero no es un certificado: el Load Balancer usa los certificados del servicio Certificates."
      }
    },
    {
      "service": "oci-cloud-advisor",
      "role": "near-miss",
      "why_not": {
        "s5": "Cloud Advisor da recomendaciones periódicas de costo, rendimiento y seguridad; no mide la CPU cada minuto ni avisa a guardia."
      }
    }
  ],
