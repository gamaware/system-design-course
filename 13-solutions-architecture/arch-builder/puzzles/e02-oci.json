  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 3.55,
        "r": 2.5
      },
      "group": "g-priv",
      "accept": [
        "oci-compute"
      ],
      "near_miss": "oci-functions",
      "hint_cue": "sistema operativo que el equipo parcha",
      "explanation": "OCI Compute da instancias de VM: cada una es un entorno de cómputo independiente cuya imagen define el sistema operativo y el demás software, y Oracle recomienda aplicarles los parches de seguridad más recientes. OCI Functions corta cada ejecución a los 300 segundos.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Functions/Tasks/functionscustomizing.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Concepts/computeoverview.htm"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 6.35,
        "r": 2.5
      },
      "group": "g-region",
      "accept": [
        "oci-instance-pool"
      ],
      "near_miss": "oci-instance-configuration",
      "hint_cue": "agrega o quita según la carga",
      "explanation": "Un instance pool crea instancias idénticas desde una instance configuration y las reparte entre dominios de falla; el autoscaling ajusta su número a la CPU entre un mínimo y un máximo, y si se termina una instancia el pool crea otra.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Tasks/autoscalinginstancepools.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Concepts/instance-pools.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Tasks/autoscaling-create-metric-based_tabs.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Concepts/instancemanagement.htm"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 3.55,
        "r": 1.15
      },
      "group": "g-pub",
      "accept": [
        "oci-load-balancer"
      ],
      "near_miss": "oci-network-load-balancer",
      "hint_cue": "manda /api a un grupo y /tienda a otro",
      "explanation": "OCI Load Balancer termina TLS con el certificado del slot 4, manda /api y /tienda a conjuntos de backends distintos con reglas por ruta y solo envía a los que pasan su revisión de salud. El Network Load Balancer es de capa 4.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Balance/Tasks/managingcertificates.htm",
        "https://docs.oracle.com/en-us/iaas/Content/NetworkLoadBalancer/overview.htm"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 6.35,
        "r": 1.15
      },
      "group": "g-region",
      "accept": [
        "oci-certificates"
      ],
      "near_miss": "oci-vault",
      "hint_cue": "presenta al navegador para probar que es tienda.mx",
      "explanation": "OCI Certificates importa el certificado de tienda.mx que emitió una CA externa, guarda sus versiones, marca cuál es la vigente y el Load Balancer lo usa por integración. Una llave de OCI Vault también tiene versiones, pero no es un certificado.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/certificates/overview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/KeyManagement/Concepts/keyoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Balance/Tasks/managingcertificates.htm"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 6.35,
        "r": 3.85
      },
      "group": "g-region",
      "accept": [
        "oci-monitoring"
      ],
      "near_miss": "oci-cloud-advisor",
      "hint_cue": "avisa a guardia",
      "explanation": "OCI Monitoring recibe la CPU de las instancias cada minuto y una alarma avisa a guardia por Notifications cuando pasa de 80 % durante 5 minutos. Cloud Advisor solo da recomendaciones periódicas.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Monitoring/Concepts/monitoringoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/CloudAdvisor/Concepts/cloudadvisoroverview.htm"
      ]
    }
  ],
