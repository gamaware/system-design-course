  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} guarda los pagos en MySQL administrado sin sacarlos de México, con una copia en otra zona que toma el control sola si cae la primaria."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} da a los reportes una copia aparte de la primaria del slot 1 para no frenarla, aunque lleve segundos de retraso."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} guarda los favoritos: cada país escribe en milisegundos en su región y ambas aceptan escrituras. La otra región los ve después, porque se prefiere disponibilidad a consistencia."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} avisa al equipo de reportes si la copia del slot 2 se atrasa más de 30 segundos respecto a la primaria."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} guarda la contraseña de la BD fuera del código: la app la pide al arrancar y una rotación programada en el mismo servicio la cambia cada 30 días."
    },
    {
      "n": 6,
      "slot": null,
      "text": "El MySQL del restaurante piloto corre en su propio local; sus pagos se migran al slot 1 antes de abrir a los 2 mil restaurantes."
    }
  ],
  "palette": [
    {
      "service": "aws-rds-multi-az",
      "why_not": {
        "s2": "El standby de Multi-AZ recibe la copia síncrona, pero a diferencia de una réplica de lectura no puede atender lecturas."
      }
    },
    {
      "service": "aws-rds-read-replica",
      "why_not": {
        "s1": "La réplica de lectura recibe los cambios en forma asíncrona y eres tú quien la promueve; no reemplaza sola a la primaria."
      }
    },
    {
      "service": "aws-dynamodb"
    },
    {
      "service": "aws-cloudwatch"
    },
    {
      "service": "aws-secrets-manager"
    },
    {
      "service": "aws-aurora-global",
      "role": "near-miss",
      "why_not": {
        "s1": "Aurora Global Database copia los datos a regiones secundarias de solo lectura, y los pagos no deben salir de México.",
        "s2": "Aurora Global Database copia un clúster de Aurora a otras regiones; no es una copia del MySQL del slot 1.",
        "s3": "En Aurora Global Database solo el clúster primario realiza las escrituras y las regiones secundarias son de solo lectura: no hay dos regiones que acepten escrituras."
      }
    },
    {
      "service": "aws-cloudtrail",
      "role": "near-miss",
      "why_not": {
        "s4": "CloudTrail registra como eventos las acciones de usuarios, roles y servicios; el retraso es la métrica ReplicaLag, que RDS publica en CloudWatch, y ahí vive la alarma."
      }
    },
    {
      "service": "aws-parameter-store",
      "role": "near-miss",
      "why_not": {
        "s5": "Parameter Store guarda contraseñas como parámetros, pero no ofrece rotación automática de los secretos que guarda."
      }
    },
    {
      "service": "aws-alb",
      "role": "filler"
    }
  ],
  "review_notes": "Tabla del Escenario 6 de ARCHITECTURES.md. Regiones apiladas: México arriba y EE. UU. abajo; el slot 3 queda entre las dos, a nivel de nube. La réplica de lectura (distractor del slot 1) y el standby de HA (distractor del slot 2) son respuestas de otro slot, así que su why_not va en la ficha de respuesta. Sin rotación nativa en Azure, GCP y OCI (E6-5): la explicación dice que la rotación necesita código propio. La ficha de relleno es un balanceador.",
  "status": "published"
}
