        "r": 3.85
      },
      "group": "g-region",
      "accept": [
        "oci-nosql-regional"
      ],
      "near_miss": "oci-object-storage",
      "hint_cue": "solo la escribe si esa clave no existe",
      "explanation": "Oracle NoSQL Database Cloud Service identifica cada fila por su llave primaria, y con la opción IfAbsent la escritura solo tiene éxito si la fila todavía no existe.",
      "refs": [
        "https://docs.oracle.com/en/cloud/paas/nosql-cloud/dtddt/designing-a-table-in-oracle-nosql-database-cloud-service.html",
        "https://docs.oracle.com/en/cloud/paas/nosql-cloud/dtddt/using-apis-to-add-table-data.html",
        "https://docs.oracle.com/en-us/iaas/Content/Object/Concepts/objectstorageoverview.htm",
        "https://docs.oracle.com/en-us/iaas/mysql-database/doc/overview-read-replica.html"
