        "gcp-vpc-firewall-rules"
      ],
      "near_miss": "gcp-cloud-armor",
      "hint_cue": "estén en la subred que estén",
      "explanation": "Las reglas de firewall de VPC tienen estado, así que la respuesta pasa sola, y pueden usar cuentas de servicio como destino y como origen: el 3306 se abre solo desde la cuenta de servicio de la app.",
      "refs": [
        "https://docs.cloud.google.com/firewall/docs/firewalls",
        "https://docs.cloud.google.com/armor/docs/security-policy-overview"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 2.2,
        "r": 5.15
      },
      "group": "g-region",
