      "id": "s2",
      "number": 2,
      "cell": {
        "c": 5.45,
        "r": 2.5
      },
      "group": "g-net",
      "accept": [
        "gcp-secure-web-proxy"
      ],
      "near_miss": null,
      "hint_cue": "el proxy que cada servidor tiene configurado",
      "explanation": "En modo de proxy explícito, cada servidor apunta directo a Secure Web Proxy, que filtra destinos por nombre de host o URL (en HTTPS, con inspección TLS). Después el tráfico sale a internet, típicamente por Cloud NAT.",
      "refs": [
        "https://docs.cloud.google.com/secure-web-proxy/docs/overview",
        "https://docs.cloud.google.com/nat/docs/overview",
        "https://docs.cloud.google.com/firewall/docs/about-url-filtering"
      ]
    },
