        "gcp-iap"
      ],
      "near_miss": "gcp-cloud-vpn",
      "hint_cue": "sin abrir el puerto 22 a internet",
      "explanation": "Con el reenvío TCP de IAP se hace SSH a VM sin IP externa; el firewall solo admite el rango 35.235.240.0/20 de IAP en el puerto 22, y Cloud Audit Logs deja ver cada solicitud de acceso.",
      "refs": [
        "https://docs.cloud.google.com/iap/docs/using-tcp-forwarding",
        "https://docs.cloud.google.com/network-connectivity/docs/vpn/concepts/overview"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 6.6,
        "r": 3.85
      },
      "group": "g-net",
      "accept": [
        "gcp-private-google-access"
      ],
      "near_miss": "gcp-vpc-peering",
      "hint_cue": "que solo tienen IP interna",
      "explanation": "Private Google Access se activa por subred y deja que las VM con solo IP interna lleguen a las APIs de Google, incluido Cloud Storage. Ese tráfico va por Private Google Access aunque la VM use Cloud NAT.",
      "refs": [
        "https://docs.cloud.google.com/vpc/docs/private-google-access",
        "https://docs.cloud.google.com/nat/docs/overview",
        "https://docs.cloud.google.com/vpc/docs/vpc-peering"
