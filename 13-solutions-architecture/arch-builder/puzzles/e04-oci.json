  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 4.5,
        "r": 2.9
      },
      "group": "g-priv",
      "accept": [
        "oci-file-storage"
      ],
      "near_miss": "oci-block-volume",
      "hint_cue": "montan a la vez por NFS",
      "explanation": "OCI File Storage usa NFSv3; cada mount target vive en una subred y acepta hasta 100,000 conexiones NFS. Dentro del dominio de disponibilidad replica de forma síncrona y tiene failover.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/File/Concepts/filestorageoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Block/Concepts/overview.htm"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 7.4,
        "r": 2.9
      },
      "group": "g-region",
      "accept": [
        "oci-fss-snapshots"
      ],
      "near_miss": "oci-fss-replication",
      "hint_cue": "versión de anoche",
      "explanation": "Una instantánea de File Storage es una vista consistente de un momento dado que queda en .snapshot/nombre, en la raíz del sistema de archivos, de donde se copia la escena borrada.",
      "refs": [
        "https://docs.oracle.com/iaas/Content/File/Tasks/managingsnapshots.htm",
        "https://docs.oracle.com/en-us/iaas/Content/File/Concepts/filestorageoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/File/Tasks/FSreplication.htm"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 7.4,
        "r": 1.2
      },
      "group": "g-region",
      "accept": [
        "oci-object-storage"
      ],
      "near_miss": "oci-block-volume",
      "hint_cue": "no dependen de ninguna instancia",
      "explanation": "Object Storage es un servicio regional que no depende de ninguna instancia de cómputo; se lee desde internet o desde la nube y guarda los datos de forma redundante en varios servidores.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Object/Concepts/objectstorageoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Block/Concepts/overview.htm"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 4.5,
        "r": 1.2
      },
      "group": "g-priv",
      "accept": [
        "oci-preemptible"
      ],
      "near_miss": "oci-capacity-reservation",
      "hint_cue": "segundos o minutos de aviso",
      "explanation": "Las instancias preemptible pueden terminarse en cualquier momento, con un evento dos minutos antes, y cuestan 50 % menos que la capacidad bajo demanda: sirven para trabajo que tolera interrupciones.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Concepts/preemptible.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Compute/Tasks/reserve-capacity.htm"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 1.95,
        "r": 2.9
      },
      "group": "g-region",
      "accept": [
        "oci-site-to-site-vpn"
      ],
      "near_miss": "oci-fastconnect",
      "hint_cue": "por el internet que ya tiene",
      "explanation": "Site-to-Site VPN usa líneas públicas de internet y cifra con IPsec toda la comunicación entre la oficina y la VCN, que pasa por el DRG.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Network/Tasks/overviewIPsec.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Network/Concepts/fastconnect.htm"
      ]
    }
