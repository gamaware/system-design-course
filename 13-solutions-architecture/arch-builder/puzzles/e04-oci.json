  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} guarda la carpeta de proyectos que cientos de servidores Linux montan a la vez por NFS, disponible en ambos dominios de falla."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} conserva la versión de anoche de la carpeta de proyectos, para recuperar una escena que alguien borre por error."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} guarda por años los cuadros terminados, que se leen por HTTP desde internet y no dependen de ninguna instancia."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} da los nodos de render: pueden apagarse con segundos o minutos de aviso porque el trabajo se reanuda, e importa el precio más bajo sin compromiso."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} une hoy mismo la oficina con la red de la nube, cifrada, por el internet que ya tiene."
    },
    {
      "n": 6,
      "slot": null,
      "text": "Los artistas trabajan en la oficina del estudio en Guadalajara y desde ahí suben sus escenas."
    }
  ],
  "palette": [
    {
      "service": "oci-file-storage"
    },
    {
      "service": "oci-fss-snapshots"
    },
    {
      "service": "oci-object-storage"
    },
    {
      "service": "oci-preemptible"
    },
    {
      "service": "oci-site-to-site-vpn"
    },
    {
      "service": "oci-block-volume",
      "role": "near-miss",
      "why_not": {
        "s1": "Un volumen de bloques se usa como el disco duro de una instancia; conectarlo a varias a la vez exige instalar una solución para clústeres, y no es una carpeta NFS.",
        "s3": "Un volumen de bloques se usa como el disco duro de una instancia; no guarda objetos que se lean por HTTP desde internet."
      }
    },
    {
      "service": "oci-fss-replication",
      "role": "near-miss",
      "why_not": {
        "s2": "La replicación deja el destino con la misma estructura de archivos y carpetas que el origen y, en cada intervalo, borra la instantánea de replicación anterior: no conserva la versión de anoche.",
        "s1": "La replicación copia un sistema de archivos que ya existe; por sí sola no es la carpeta que montan los servidores."
      }
    },
    {
      "service": "oci-capacity-reservation",
      "role": "near-miss",
      "why_not": {
        "s4": "Una reserva de capacidad aparta instancias, pero se cobran a la tarifa normal y la capacidad sin usar se cobra al 85 %: no abarata los nodos."
      }
    },
    {
      "service": "oci-fastconnect",
      "role": "near-miss",
      "why_not": {
        "s5": "FastConnect crea una conexión dedicada y privada entre el centro de datos y Oracle Cloud, no el túnel cifrado por el internet que la oficina ya tiene."
      }
    }
  ],
  "review_notes": "Escenario 4 de ARCHITECTURES.md. Querétaro tiene un solo AD: las columnas son dominios de falla y los requisitos 1 y 3 se ajustan (OCI no documenta redundancia por zona de Object Storage; el requisito 3 pide no depender de ninguna instancia). Block Volume es near-miss de s1 y s3. Revisión a ciegas: Block Volume, la replicación de File Storage y FastConnect ya se apoyan en sus propias páginas de Oracle.",
  "status": "published"
}
