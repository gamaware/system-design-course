    {
      "service": "azure-functions",
      "role": "near-miss",
      "why_not": {
        "s1": "Azure Functions es una solución sin servidores que ejecuta código con disparadores por evento: en vez de desplegar y mantener servidores, el equipo escribe solo el código y Azure se encarga del resto."
      }
    },
    {
      "service": "azure-availability-set",
      "role": "near-miss",
      "why_not": {
        "s2": "Un availability set reparte VM en dominios de falla y de actualización, pero no agrega ni quita VM según la carga."
      }
    },
    {
      "service": "azure-load-balancer",
      "role": "near-miss",
      "why_not": {
        "s3": "Azure Load Balancer trabaja en capa 4: reparte flujos TCP y UDP, pero no descifra el HTTPS ni lee la URL."
      }
    },
    {
      "service": "azure-managed-hsm",
      "role": "near-miss",
      "why_not": {
        "s4": "Managed HSM guarda llaves en un HSM dedicado, pero no admite certificados, que es lo que Application Gateway presenta en el HTTPS."
      }
    },
    {
      "service": "azure-advisor",
      "role": "near-miss",
      "why_not": {
        "s5": "Azure Advisor analiza la configuración y da recomendaciones periódicas; no vigila la CPU minuto a minuto ni avisa a guardia."
      }
    }
  ],
