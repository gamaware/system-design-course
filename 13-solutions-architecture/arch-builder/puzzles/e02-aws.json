      }
    },
    {
      "service": "aws-launch-template",
      "role": "near-miss",
      "why_not": {
        "s2": "Un launch template es solo la plantilla con la AMI y el tipo de instancia: no mantiene copias ni reemplaza las que fallan."
      }
    },
    {
      "service": "aws-nlb",
      "role": "near-miss",
      "why_not": {
        "s3": "El Network Load Balancer trabaja en capa 4: reparte conexiones TCP, pero no lee la URL para mandar /api y /tienda a grupos distintos."
      }
    },
    {
      "service": "aws-kms",
      "role": "near-miss",
      "why_not": {
        "s4": "KMS crea y controla llaves para cifrar y firmar datos, pero el ALB presenta un certificado X.509, que ACM emite y renueva."
      }
    },
    {
      "service": "aws-trusted-advisor",
      "role": "near-miss",
      "why_not": {
        "s5": "Trusted Advisor da recomendaciones periódicas de buenas prácticas; no mide la CPU cada minuto ni avisa a guardia."
      }
    }
  ],
