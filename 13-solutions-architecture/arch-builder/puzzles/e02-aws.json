  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 3.55,
        "r": 2.5
      },
      "group": "g-priv",
      "accept": [
        "aws-ec2"
      ],
      "near_miss": "aws-lambda",
      "hint_cue": "sistema operativo que el equipo parcha",
      "explanation": "Amazon EC2 da instancias con sistema operativo completo: el equipo las parcha, les instala su agente y corren sin límite de tiempo. Lambda no da acceso al sistema operativo y corta cada ejecución a los 15 minutos.",
      "refs": [
        "https://docs.aws.amazon.com/lambda/latest/dg/configuration-timeout.html"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 6.35,
        "r": 2.5
      },
      "group": "g-region",
      "accept": [
        "aws-ec2-auto-scaling"
      ],
      "near_miss": "aws-launch-template",
      "hint_cue": "reemplaza las que fallan",
      "explanation": "Un grupo de EC2 Auto Scaling mantiene la capacidad entre el mínimo y el máximo, reparte instancias entre zonas, escala con la carga y reemplaza las que fallan su revisión de salud. Un launch template solo describe cómo lanzarlas.",
      "refs": [
        "https://docs.aws.amazon.com/autoscaling/ec2/userguide/ec2-auto-scaling-health-checks.html"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 3.55,
        "r": 1.15
      },
      "group": "g-pub",
      "accept": [
        "aws-alb"
      ],
      "near_miss": "aws-nlb",
      "hint_cue": "manda /api a un grupo y /tienda a otro",
      "explanation": "El Application Load Balancer termina TLS, manda /api y /tienda a grupos de destino distintos con reglas por ruta y solo envía a destinos que pasan su revisión de salud. El Network Load Balancer es de capa 4 y no lee la URL.",
      "refs": [
        "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/introduction.html"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 6.35,
        "r": 1.15
      },
      "group": "g-region",
      "accept": [
        "aws-acm"
      ],
      "near_miss": "aws-kms",
      "hint_cue": "presenta al navegador para probar que es tienda.mx",
      "explanation": "El ALB presenta un certificado X.509 que prueba el dominio; ACM emite el público de tienda.mx y lo renueva automáticamente mientras esté en uso y su CNAME de validación siga en el DNS. KMS guarda llaves, no certificados.",
      "refs": [
        "https://docs.aws.amazon.com/acm/latest/userguide/dns-renewal-validation.html",
        "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/https-listener-certificates.html",
        "https://docs.aws.amazon.com/kms/latest/developerguide/overview.html"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 6.35,
        "r": 3.85
      },
      "group": "g-region",
      "accept": [
        "aws-cloudwatch"
      ],
      "near_miss": "aws-trusted-advisor",
      "hint_cue": "avisa a guardia",
      "explanation": "CloudWatch recibe la CPU de las instancias cada minuto y una alarma cambia a ALARM cuando pasa de 80 % durante 5 minutos; su acción avisa a guardia. Trusted Advisor solo da revisiones periódicas.",
      "refs": [
        "https://docs.aws.amazon.com/autoscaling/ec2/userguide/as-scaling-simple-step.html",
        "https://aws.amazon.com/premiumsupport/technology/trusted-advisor/"
      ]
    }
  ],
