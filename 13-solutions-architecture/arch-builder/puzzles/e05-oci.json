    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 2.5,
        "r": 1.5
      },
      "group": "g-region",
      "accept": [
        "oci-api-gateway"
      ],
      "near_miss": "oci-network-load-balancer",
      "hint_cue": "token inválido, caducado o de otro emisor",
      "explanation": "El gateway valida la firma del JWT y los claims exp, aud e iss; si el token falta o no es válido responde HTTP 401 por omisión, y solo con la validación exitosa manda la solicitud al backend.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/APIGateway/Tasks/apigatewayusingjwttokens.htm",
        "https://docs.oracle.com/en-us/iaas/Content/NetworkLoadBalancer/overview.htm"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 6.75,
        "r": 0.5
      },
      "group": "g-region",
      "accept": [
        "oci-vault"
      ],
      "near_miss": "oci-secret-management",
      "hint_cue": "llaves de la empresa que rotan cada año",
      "explanation": "OCI Vault guarda las llaves maestras de los servicios integrados; en una bóveda privada rotan cada 60 a 365 días, y su registro de operaciones criptográficas, si se activa, anota quién usó qué llave.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/KeyManagement/Concepts/keyoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Logging/Reference/details_for_kms.htm",
        "https://docs.oracle.com/en-us/iaas/Content/secret-management/home.htm"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 6.75,
        "r": 2.3
      },
      "group": "g-region",
      "accept": [
        "oci-cloud-guard"
      ],
      "near_miss": "oci-vulnerability-scanning",
      "hint_cue": "IP sospechosa",
      "explanation": "La regla Suspicious Ip Activity del detector de actividad de Cloud Guard alerta cuando alguien inicia sesión o llama a una API desde una IP sospechosa, con datos del servicio Threat Intelligence.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/cloud-guard/home.htm",
        "https://docs.oracle.com/en-us/iaas/cloud-guard/using/detect-recipes.htm",
        "https://docs.oracle.com/en-us/iaas/scanning/home.htm"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 6.75,
        "r": 3.6
      },
      "group": "g-region",
      "accept": [
        "oci-audit"
      ],
      "near_miss": "oci-vcn-flow-logs",
      "hint_cue": "quién cambió una regla de firewall",
      "explanation": "OCI Audit registra las llamadas a las API públicas de OCI con la hora, el origen, el destino y el tipo de acción; cada evento guarda además el usuario (principalName) y la IP de la solicitud.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Audit/Concepts/auditoverview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Audit/Reference/logeventreference.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Network/Concepts/vcn-flow-logs.htm"
      ]
