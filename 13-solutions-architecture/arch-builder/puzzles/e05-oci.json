      "group": "g-region",
      "accept": [
        "oci-identity-domains"
      ],
      "near_miss": "oci-iam-policies",
      "hint_cue": "con su cuenta de Google",
      "explanation": "Un dominio de identidad de OCI IAM acepta a Google como proveedor social; la app registrada recibe un token de acceso con caducidad configurable y un token de actualización para pedir otro sin volver a autenticarse.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Identity/identityproviders/add-social-identity-provider.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Identity/applications/add-confidential-application.htm",
