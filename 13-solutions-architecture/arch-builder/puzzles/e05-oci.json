  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} deja que los alumnos entren con correo o con su cuenta de Google, y la app recibe tokens OAuth 2.0 / OIDC que caducan y se renuevan con un token de actualización."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} rechaza cualquier llamada a /pagos con un token inválido, caducado o de otro emisor antes de que llegue al servicio."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} cifra la BD y los respaldos con llaves de la empresa que rotan cada año, y cada uso de esas llaves se puede registrar."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} alerta si alguien opera los recursos de la nube desde una IP sospechosa."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} le muestra al auditor quién cambió una regla de firewall o borró un recurso, cuándo y desde dónde."
    },
    {
      "n": 6,
      "slot": null,
      "text": "El servicio de pagos corre en la subred privada y solo recibe las llamadas que ya validó el slot 2."
    },
    {
      "n": 7,
      "slot": null,
      "text": "La base de datos guarda las cuentas de los becarios y sus depósitos, cifrados con las llaves del slot 3."
    }
  ],
  "palette": [
    {
      "service": "oci-identity-domains"
    },
    {
      "service": "oci-api-gateway"
    },
    {
      "service": "oci-vault"
    },
    {
      "service": "oci-cloud-guard"
    },
    {
      "service": "oci-audit"
    },
    {
      "service": "oci-iam-policies",
      "role": "near-miss",
      "why_not": {
        "s1": "Una política de IAM dice quién puede acceder a qué recursos de la tenencia y cómo; no da inicio de sesión a los alumnos de la app."
      }
    },
    {
      "service": "oci-network-load-balancer",
      "role": "near-miss",
      "why_not": {
        "s2": "OCI Network Load Balancer reparte conexiones con datos de capa 3 y 4 y es de paso, no un proxy: no valida el token de la llamada."
      }
    },
    {
      "service": "oci-secret-management",
      "role": "near-miss",
      "why_not": {
        "s3": "Secret Management guarda secretos, como contraseñas, certificados y llaves SSH, cifrados con una llave maestra; no es el servicio que crea y rota esas llaves."
      }
    },
    {
      "service": "oci-vulnerability-scanning",
      "role": "near-miss",
      "why_not": {
        "s4": "Vulnerability Scanning revisa hosts e imágenes de contenedor en busca de vulnerabilidades; no alerta por llamadas a la API desde una IP sospechosa."
      }
    },
    {
      "service": "oci-vcn-flow-logs",
      "role": "near-miss",
      "why_not": {
        "s5": "Los registros de flujo de la VCN muestran detalles del tráfico que pasa por la VCN; no dicen quién cambió una regla de firewall ni quién borró un recurso."
      }
    }
  ],
  "review_notes": "Tabla del Escenario 5 de ARCHITECTURES.md, con los ajustes de la revisión a ciegas: el token sin duración fija, el registro de cada uso de la llave como opción (se activa por bóveda) y la amenaza del slot 4 como operación desde una IP sospechosa, porque Cloud Guard no documenta una regla de minería. La rotación automática de llaves solo existe en una bóveda privada virtual. Secret Management usa la figura de Vault de la librería oficial, porque no hay una propia.",
  "status": "published"
}
