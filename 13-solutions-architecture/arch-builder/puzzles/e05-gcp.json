  "slots": [
    {
      "id": "s1",
      "number": 1,
      "cell": {
        "c": 1.25,
        "r": 1.5
      },
      "group": "g-region",
      "accept": [
        "gcp-identity-platform"
      ],
      "near_miss": "gcp-iam",
      "hint_cue": "con su cuenta de Google",
      "explanation": "Identity Platform agrega el inicio de sesión con correo o con Google y emite un token de ID que caduca; con el token de actualización, la app pide un token de ID nuevo.",
      "refs": [
        "https://docs.cloud.google.com/identity-platform/docs/concepts",
        "https://docs.cloud.google.com/identity-platform/docs/use-rest-api",
        "https://docs.cloud.google.com/iam/docs/overview"
      ]
    },
    {
      "id": "s2",
      "number": 2,
      "cell": {
        "c": 2.5,
        "r": 1.5
      },
      "group": "g-region",
      "accept": [
        "gcp-apigee"
      ],
      "near_miss": "gcp-passthrough-nlb",
      "hint_cue": "token inválido, caducado o de otro emisor",
      "explanation": "La política VerifyJWT de Apigee revisa la firma del JWT con la llave pública o un JWKS, la caducidad y, si se configura, el emisor y la audiencia; si algo falla, detiene el proceso y responde con error. Apigee corre en northamerica-south1.",
      "refs": [
        "https://docs.cloud.google.com/api-gateway/docs/authenticating-users-jwt",
        "https://docs.cloud.google.com/load-balancing/docs/passthrough-network-load-balancer",
        "https://docs.cloud.google.com/apigee/docs/api-platform/reference/policies/verify-jwt-policy",
        "https://docs.cloud.google.com/apigee/docs/locations",
        "https://docs.cloud.google.com/api-gateway/docs/deployment-model"
      ]
    },
    {
      "id": "s3",
      "number": 3,
      "cell": {
        "c": 6.75,
        "r": 0.5
      },
      "group": "g-region",
      "accept": [
        "gcp-cloud-kms"
      ],
      "near_miss": "gcp-secret-manager",
      "hint_cue": "llaves de la empresa que rotan cada año",
      "explanation": "Cloud KMS rota las llaves de forma automática con un calendario que define el equipo, y cada Encrypt o Decrypt queda en los registros de auditoría de acceso a datos cuando estos se activan.",
      "refs": [
        "https://docs.cloud.google.com/kms/docs/key-rotation",
        "https://docs.cloud.google.com/kms/docs/audit-logging",
        "https://docs.cloud.google.com/logging/docs/audit",
        "https://docs.cloud.google.com/secret-manager/docs/overview"
      ]
    },
    {
      "id": "s4",
      "number": 4,
      "cell": {
        "c": 6.75,
        "r": 2.3
      },
      "group": "g-region",
      "accept": [
        "gcp-security-command-center"
      ],
      "near_miss": "gcp-artifact-analysis",
      "hint_cue": "IP sospechosa",
      "explanation": "Event Threat Detection, del nivel Premium de Security Command Center, revisa los registros y crea hallazgos, por ejemplo cuando alguien modifica servicios desde una IP asociada a la red Tor.",
      "refs": [
        "https://docs.cloud.google.com/security-command-center/docs/concepts-event-threat-detection-overview",
        "https://docs.cloud.google.com/artifact-analysis/docs/container-scanning-overview"
      ]
    },
    {
      "id": "s5",
      "number": 5,
      "cell": {
        "c": 6.75,
        "r": 3.6
      },
      "group": "g-region",
      "accept": [
        "gcp-cloud-audit-logs"
      ],
      "near_miss": "gcp-vpc-flow-logs",
      "hint_cue": "quién cambió una regla de firewall",
      "explanation": "Cloud Audit Logs responde quién hizo qué, dónde y cuándo: los registros de Admin Activity se escriben siempre que alguien cambia la configuración y guardan la IP de quien llama.",
      "refs": [
        "https://docs.cloud.google.com/logging/docs/audit",
        "https://docs.cloud.google.com/logging/docs/reference/audit/auditlog/rest/Shared.Types/AuditLog",
        "https://docs.cloud.google.com/vpc/docs/flow-logs"
      ]
    }
