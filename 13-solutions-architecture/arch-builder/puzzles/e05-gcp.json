  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} deja que los alumnos entren con correo o con su cuenta de Google, y la app recibe tokens OAuth 2.0 / OIDC que caducan y se renuevan con un token de actualización."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} corre en la región de México y rechaza cualquier llamada a /pagos con un token inválido, caducado o de otro emisor antes de que llegue al servicio."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} cifra la BD y los respaldos con llaves de la empresa que rotan cada año, y cada uso de esas llaves se puede registrar."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} alerta si alguien opera los recursos de la nube desde una IP sospechosa."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} le muestra al auditor quién cambió una regla de firewall o borró un recurso, cuándo y desde dónde."
    },
    {
      "n": 6,
      "slot": null,
      "text": "El servicio de pagos corre en la subred privada y solo recibe las llamadas que ya validó el slot 2."
    },
    {
      "n": 7,
      "slot": null,
      "text": "La base de datos guarda las cuentas de los becarios y sus depósitos, cifrados con las llaves del slot 3."
    }
  ],
  "palette": [
    {
      "service": "gcp-identity-platform"
    },
    {
      "service": "gcp-apigee"
    },
    {
      "service": "gcp-cloud-kms"
    },
    {
      "service": "gcp-security-command-center"
    },
    {
      "service": "gcp-cloud-audit-logs"
    },
    {
      "service": "gcp-iam",
      "role": "near-miss",
      "why_not": {
        "s1": "IAM de Google Cloud controla quién puede hacer qué sobre cuáles recursos; no da registro ni inicio de sesión a los alumnos de la app."
      }
    },
    {
      "service": "gcp-passthrough-nlb",
      "role": "near-miss",
      "why_not": {
        "s2": "El balanceador de red de paso es de capa 4 y no es un proxy: pasa las conexiones tal cual, sin validar el token."
      }
    },
    {
      "service": "gcp-secret-manager",
      "role": "near-miss",
      "why_not": {
        "s3": "Secret Manager guarda datos sensibles como llaves de API, contraseñas y certificados; no es el servicio que crea y rota las llaves de cifrado de la BD."
      }
    },
    {
      "service": "gcp-artifact-analysis",
      "role": "near-miss",
      "why_not": {
        "s4": "Artifact Analysis busca vulnerabilidades y paquetes maliciosos en los artefactos de Artifact Registry; no alerta por cambios hechos desde una IP sospechosa."
      }
    },
    {
      "service": "gcp-vpc-flow-logs",
      "role": "near-miss",
      "why_not": {
        "s5": "Los registros de flujo de VPC toman muestras de los paquetes que envían y reciben las VM; no dicen quién cambió una regla de firewall ni quién borró un recurso."
      }
    },
    {
      "service": "gcp-api-gateway",
      "role": "distractor",
      "why_not": {
        "s2": "API Gateway valida JWT, pero sus gateways solo se despliegan en 10 regiones y ninguna es northamerica-south1, la región de México donde corre el servicio de pagos."
      }
    }
  ],
  "review_notes": "Tabla del Escenario 5 de ARCHITECTURES.md, con los ajustes de la revisión a ciegas: el token sin duración fija (el de ID de Identity Platform no se configura), el registro de cada uso de la llave como opción (los registros de acceso a datos vienen apagados) y la amenaza del slot 4 como operación desde una IP sospechosa. Event Threat Detection requiere el nivel Premium de Security Command Center. Iconos de categoría salvo Security Command Center, que tiene icono propio. Revisión final: API Gateway de Google Cloud no se despliega en northamerica-south1 (su página de modelo de despliegue lista 10 regiones); el slot 2 pasa a Apigee, cuyo runtime está en northamerica-south1 y valida el JWT con la política VerifyJWT. API Gateway queda como distractor y el requisito 2 dice que la pieza corre en la región de México.",
  "status": "published"
}
