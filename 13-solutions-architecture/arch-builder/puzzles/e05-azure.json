        "azure-api-management"
      ],
      "near_miss": "azure-load-balancer",
      "hint_cue": "token inválido, caducado o de otro emisor",
      "explanation": "La política validate-jwt de API Management exige un JWT válido: revisa la firma, el emisor, la audiencia y que traiga caducidad; si no pasa la validación, responde 401.",
      "refs": [
        "https://learn.microsoft.com/en-us/azure/api-management/validate-jwt-policy",
        "https://learn.microsoft.com/en-us/azure/load-balancer/load-balancer-overview"
