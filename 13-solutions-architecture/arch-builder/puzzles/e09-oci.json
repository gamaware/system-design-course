        "oci-health-checks"
      ],
      "near_miss": "oci-lb-health-check",
      "hint_cue": "prueba desde varios puntos de internet",
      "explanation": "Health Checks monitorea desde puntos de observación en el mundo cualquier servicio público, como un balanceador externo, con intervalos de 10 s o más, y la política de failover usa esos monitores.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/HealthChecks/Concepts/healthchecks.htm",
        "https://docs.oracle.com/en-us/iaas/Content/TrafficManagement/Concepts/overview.htm",
        "https://docs.oracle.com/en-us/iaas/Content/Balance/Tasks/managingcertificates.htm"
      ]
