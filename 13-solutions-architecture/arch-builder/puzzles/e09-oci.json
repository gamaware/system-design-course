      ],
      "near_miss": "oci-api-gateway",
      "hint_cue": "termina TLS y reparte las peticiones",
      "explanation": "OCI Load Balancer termina SSL en un listener, por ejemplo en el puerto 443, con su paquete de certificados, y reparte entre los servidores de un backend set, que lleva su propia política de health check.",
      "refs": [
        "https://docs.oracle.com/en-us/iaas/Content/Balance/Tasks/managingcertificates.htm",
        "https://docs.oracle.com/en-us/iaas/Content/APIGateway/Concepts/apigatewayoverview.htm"
      ]
    },
