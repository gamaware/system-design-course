  "requirements": [
    {
      "n": 1,
      "slot": "s1",
      "text": "{{s1}} publica un solo nombre, tienda.mx, y responde con la dirección de la región A mientras esté sana y, si no, con la de la B, con un TTL de 60 s."
    },
    {
      "n": 2,
      "slot": "s2",
      "text": "{{s2}} prueba desde varios puntos de internet, cada cierto intervalo, que el balanceador de cada región responda; si una falla, el slot 1 deja de anunciarla."
    },
    {
      "n": 3,
      "slot": "s3",
      "text": "{{s3}} recibe el HTTPS en la región A, termina TLS y reparte las peticiones solo entre las VM web que pasan su revisión de salud."
    },
    {
      "n": 4,
      "slot": "s4",
      "text": "{{s4}} administra como grupo las VM web de la región A, repartidas en dominios de falla, y crece o se reduce con la carga."
    },
    {
      "n": 5,
      "slot": "s5",
      "text": "{{s5}} le entrega a guardia el aviso de la alarma cuando el slot 2 marca caída una región; desde ese aviso corre el tiempo de reparación."
    },
    {
      "n": 6,
      "slot": "s6",
      "text": "{{s6}} hace en la región B lo mismo que el slot 3 en la A: termina TLS y reparte solo entre las VM web sanas."
    },
    {
      "n": 7,
      "slot": "s7",
      "text": "{{s7}} hace lo mismo que el slot 4 con las VM web de la región B: las administra como grupo y crece o se reduce con la carga."
    }
  ],
  "palette": [
    {
      "service": "oci-steering-policies"
    },
    {
      "service": "oci-health-checks"
    },
    {
      "service": "oci-load-balancer",
      "uses": 2
    },
    {
      "service": "oci-instance-pool",
      "uses": 2
    },
    {
      "service": "oci-notifications"
    },
    {
      "service": "oci-dns-private-resolver",
      "role": "near-miss",
      "why_not": {
        "s1": "El resolver privado contesta consultas de nombres dentro de las VCN, y las políticas que eligen respuestas según su salud solo existen para DNS público, no para DNS privado."
      }
    },
    {
      "service": "oci-lb-health-check",
      "role": "near-miss",
      "why_not": {
        "s2": "La política de health check del backend set revisa los servidores detrás del balanceador; las políticas de DNS evalúan la salud de sus respuestas con monitores y sondeos de Health Checks, no con esta política."
      }
    },
    {
      "service": "oci-api-gateway",
      "role": "near-miss",
      "why_not": {
        "s3": "API Gateway sirve para publicar APIs con endpoints privados o públicos; aquí se pide terminar SSL en un listener y repartir entre los servidores de un backend set.",
        "s6": "API Gateway sirve para publicar APIs con endpoints privados o públicos; aquí se pide terminar SSL en un listener y repartir entre los servidores de un backend set."
      }
    },
    {
      "service": "oci-instance-configuration",
      "role": "near-miss",
      "why_not": {
        "s4": "Una instance configuration es la plantilla con la imagen, la forma y los metadatos para crear instancias; no administra un grupo ni crece con la carga.",
        "s7": "Una instance configuration es la plantilla con la imagen, la forma y los metadatos para crear instancias; no administra un grupo ni crece con la carga."
      }
    },
    {
      "service": "oci-compute",
      "role": "distractor",
      "why_not": {
        "s4": "Cada VM web del diagrama ya es una instancia de Compute; el slot pide el conjunto que las administra como grupo y crece o se reduce con la carga.",
        "s7": "Cada VM web del diagrama ya es una instancia de Compute; el slot pide el conjunto que las administra como grupo y crece o se reduce con la carga."
      }
    },
    {
      "service": "oci-logging",
      "role": "near-miss",
      "why_not": {
        "s5": "Logging da acceso a los registros de los recursos de la tenancy para buscarlos y filtrarlos; el aviso a guardia lo entrega el servicio al que la alarma publica su mensaje."
      }
    }
  ],
  "review_notes": "Escenario 9 (Lab 04). OCI documenta health checks solo para las políticas de failover y de balanceo, así que el requisito 1 pide failover (región A mientras esté sana; si no, B) en lugar de la más cercana. La fuente del escenario no dice que un instance pool recree instancias que fallan, así que los requisitos 4 y 7 piden administrar como grupo y escalar, sin prometer reparación. Columnas = dominios de falla (Querétaro tiene un solo AD). Slots 6 y 7 = balanceador e instance pool de la región B (uses 2). La fuente del autoscaling es la del escenario 2.",
  "status": "published"
}
