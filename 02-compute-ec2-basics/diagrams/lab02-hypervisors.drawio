          <mxGeometry x="480" y="885" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vmt-2-box" value="Guest" style="fillColor=#FFF2E8;strokeColor=#ED7100;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#ED7100;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="690" y="850" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vmt-2" value="Your machine&lt;div&gt;&lt;i&gt;fastest, but temporary&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.instance;shadow=1;fontFamily=Helvetica;" vertex="1" parent="vmt-2-box">
          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Disk inside the host&lt;/b&gt;&lt;div&gt;&lt;i&gt;No network in the way, so it is the fastest of the three. On AWS this is the instance store, and whatever is on it disappears when the instance stops.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=none;fontColor=light-dark(#333333,#FAFAFA);" vertex="1" parent="1">
          <mxGeometry x="840" y="860" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="efs-box" value="File storage" style="fillColor=#E8F5E9;strokeColor=#3F8624;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#3F8624;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="990" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="efs" value="EFS or FSx&lt;div&gt;&lt;i&gt;shared file system&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_file_system;shadow=1;fontFamily=Helvetica;" vertex="1" parent="efs-box">
          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="net-3" value="Network" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#8C4FFF;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#8C4FFF;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1025" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hyp-3-ghost" value="Hypervisor&lt;div&gt;&lt;i&gt;not involved&lt;/i&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;fontSize=11;fontColor=light-dark(#879196,#879196);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="986" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="vmt-3-box" value="Guest" style="fillColor=#FFF2E8;strokeColor=#ED7100;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#ED7100;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="690" y="990" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vmt-3" value="Your machine&lt;div&gt;&lt;i&gt;mounts it over the vNIC&lt;/i&gt;&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.instance;shadow=1;fontFamily=Helvetica;" vertex="1" parent="vmt-3-box">
          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Shared file system&lt;/b&gt;&lt;div&gt;&lt;i&gt;It arrives through the virtual network card, so the hypervisor never handles it and many machines can mount the same files. On AWS this is EFS or FSx.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=none;fontColor=light-dark(#333333,#FAFAFA);" vertex="1" parent="1">
          <mxGeometry x="840" y="1000" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-ebs-net" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="ebs-box" target="net-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-net-hyp1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="net-1" target="hyp-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
