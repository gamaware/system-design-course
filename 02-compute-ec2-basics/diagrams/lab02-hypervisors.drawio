          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-disk-hyp2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="disk-box" target="hyp-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-disk-hyp2-label" value="no network in the way" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-disk-hyp2">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <mxPoint y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-hyp2-vm" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="hyp-2" target="vmt-2-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-efs-net3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="efs-box" target="net-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-net3-vm" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;elbow=vertical;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=none;orthogonalLoop=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1" source="net-3" target="vmt-3-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-net3-vm-label" value="straight to the virtual network card" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=default;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-net3-vm">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <mxPoint y="16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="band-types" value="Two kinds of hypervisor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="1180" width="1100" height="300" as="geometry" />
        </mxCell>
        <mxCell id="type1" value="Type 1 - bare metal: the hypervisor runs on the hardware itself" style="rounded=1;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="1230" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="t1-vm1" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type1">
          <mxGeometry x="14" y="30" width="142" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1-vm2" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type1">
          <mxGeometry x="169" y="30" width="142" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1-vm3" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type1">
          <mxGeometry x="324" y="30" width="142" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1-hyp" value="Hypervisor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;fontSize=12;fontStyle=1;fontColor=#ED7100;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type1">
          <mxGeometry x="14" y="80" width="452" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1-hw" value="Hardware" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type1">
          <mxGeometry x="14" y="130" width="452" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1-note" value="&lt;i&gt;Lower latency and stronger isolation, so this is what clouds run. VMware ESXi, Hyper-V, KVM, Xen.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=none;fontColor=light-dark(#333333,#FAFAFA);" vertex="1" parent="type1">
          <mxGeometry x="14" y="180" width="452" height="40" as="geometry" />
        </mxCell>
        <mxCell id="type2" value="Type 2 - hosted: the hypervisor is an application on a desktop system" style="rounded=1;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="1230" width="480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="t2-vm1" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="14" y="28" width="142" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-vm2" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="169" y="28" width="142" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-vm3" value="VM" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="324" y="28" width="142" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-hyp" value="Hypervisor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;fontSize=12;fontStyle=1;fontColor=#ED7100;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="14" y="70" width="452" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-hostos" value="Host operating system" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFEBEE;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="14" y="112" width="452" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-hw" value="Hardware" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontSize=12;fontColor=light-dark(#333333,#FAFAFA);align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="type2">
          <mxGeometry x="14" y="154" width="452" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t2-note" value="&lt;i&gt;The extra layer in red costs latency, which is fine on a laptop. VirtualBox, VMware Workstation, Parallels.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=none;fontColor=light-dark(#333333,#FAFAFA);" vertex="1" parent="type2">
          <mxGeometry x="14" y="194" width="452" height="30" as="geometry" />
        </mxCell>
        <mxCell id="badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="568" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="464" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="272" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="756" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="896" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="12" y="1036" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1190" y="30" width="650" height="1470" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="62" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;The host owns the real resources&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; One physical server with a processor, memory, a network card and some storage. On its own it serves one operating system at a time.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="60" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="232" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;The hypervisor cuts them into shares&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; It is the software that virtualizes the host. The processor becomes vCPUs, the memory becomes vRAM, the network card becomes vNICs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="230" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="402" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Each machine gets its own share&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; It boots its own operating system and sees only its slice. Machines are added until the host is full, and none of them can read its neighbours.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="400" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="572" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Storage route one: over the network&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The volume lives elsewhere and reaches the host over the network; the hypervisor hands it to the machine as a plain disk. This is the EBS volume in Task 4, and it survives a stop.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="570" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="742" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Storage route two: a disk in the host&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The hypervisor passes through a disk physically inside the server. Nothing crosses the network, so it is the fastest route, and it is also the one you lose when the instance stops.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="740" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="912" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Storage route three: around the hypervisor&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; A shared file system is mounted over the virtual network card, so the hypervisor never takes part. Many machines can read the same files at once. On AWS, EFS or FSx.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1264" y="910" width="548" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1212" y="1046" width="606" height="434" as="geometry" />
        </mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;Type 1 and type 2&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; &lt;b&gt;Type 1&lt;/b&gt; sits straight on the hardware. Fewer layers means lower latency and less to attack, which is why providers use it. The instance in this lab runs on the AWS Nitro hypervisor, a type 1 built on KVM.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; &lt;b&gt;Type 2&lt;/b&gt; runs as an application on a desktop operating system. The extra layer costs latency, which is acceptable on a laptop but not in a data centre.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why the course cares&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Without a hypervisor, one box serves one tenant. With one, the same box serves many isolated machines: that is multitenancy, and it is what makes renting compute cheap.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The instance type you pick in Task 4, t3.micro, names the size of the slice: how much vCPU and vRAM the hypervisor hands your machine.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Storage is the one resource the hypervisor does not always mediate, which is why the three routes above behave so differently when an instance is stopped.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1222" y="1054" width="586" height="418" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>