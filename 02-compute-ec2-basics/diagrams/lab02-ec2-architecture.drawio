        <mxCell id="subtitle-text" value="What the launch wizard builds: a t3.micro in a public subnet, a security group that only admits SSH from your IP, and an 8 GB EBS root volume" style="text;html=1;resizable=0;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group">
