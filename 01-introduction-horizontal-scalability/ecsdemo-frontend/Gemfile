source 'https://rubygems.org'

ruby '~> 3.4.0'

# Only the Rails frameworks this app uses: controllers and views.
# The app has no database, mailers, jobs, or JavaScript, so Active Record,
# Action Mailer, Active Job, and the old Sprockets/CoffeeScript/Sass stack
# (and its JavaScript runtime, therubyracer) are not needed.
rails_version = '~> 8.1.4'
gem 'actionpack', rails_version
gem 'actionview', rails_version
gem 'railties', rails_version

# Serves the SVG diagrams in app/assets/images (used by image_tag).
gem 'propshaft', '~> 1.3'

# Application server used by `rails server`.
gem 'puma', '~> 8.0'
