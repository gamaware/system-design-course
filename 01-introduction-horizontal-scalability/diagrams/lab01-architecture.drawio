        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1560" y="30" width="650" height="1330" as="geometry" />
        </mxCell>

        <mxCell id="s1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="62" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" value="&lt;div&gt;&lt;b&gt;CDK deploys the four stacks&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;cdk deploy&lt;/code&gt; synthesizes CloudFormation for base, frontend, nodejs and crystal. The code is the source of truth for every box in this diagram.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="60" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="154" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" value="&lt;div&gt;&lt;b&gt;Students reach the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;A browser request enters through the internet gateway on port 80. Nothing in the private subnets is reachable from the internet.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="152" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="246" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" value="&lt;div&gt;&lt;b&gt;The load balancer spreads the traffic&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The ALB forwards to the target group on port 3000 and splits requests across every healthy frontend task, in any of the three Availability Zones.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="244" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="338" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" value="&lt;div&gt;&lt;b&gt;The frontend calls the two backends&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Each page render fans out to the Node.js and Crystal APIs on port 3000. Only the frontend is scaled in this lab; the backends stay at one task.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="336" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="430" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s5-desc" value="&lt;div&gt;&lt;b&gt;Cloud Map resolves the service names&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Tasks register in the private DNS namespace &lt;code&gt;service.local&lt;/code&gt;, so the frontend never needs a task IP address. New tasks are discoverable as soon as they are healthy.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="428" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="522" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s6-desc" value="&lt;div&gt;&lt;b&gt;The load generator pushes CPU up&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;ab&lt;/code&gt; or &lt;code&gt;siege&lt;/code&gt; runs on an EC2 instance inside the same VPC. A laptop over the internet cannot saturate the tasks.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="520" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="614" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s7-desc" value="&lt;div&gt;&lt;b&gt;CloudWatch records the service CPU&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;One &lt;code&gt;CPUUtilization&lt;/code&gt; datapoint per minute, averaged over the whole service. This single number is the only input to the scaling decision.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="612" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="706" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s8-desc" value="&lt;div&gt;&lt;b&gt;Two alarms watch the target&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Target tracking creates them for you: the high alarm fires after 3 minutes above the 30 % target, the low alarm after 15 minutes below it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="704" width="558" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s9-badge" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="798" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s9-desc" value="&lt;div&gt;&lt;b&gt;Auto Scaling changes desiredCount&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Application Auto Scaling writes a new task count on the ECS service, between 1 and 10, and the loop starts again. This is horizontal scaling: more copies, not bigger ones.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1632" y="796" width="558" height="100" as="geometry" />
        </mxCell>

