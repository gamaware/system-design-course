        <mxCell id="badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="940" y="465" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1210" y="465" width="28" height="28" as="geometry" />
        </mxCell>

        <mxCell id="band-c" value="Drift, side by side" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c-code" value="&lt;div&gt;&lt;b&gt;What the repository says&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;ecsdemo-frontend/cdk/app.py&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;desired_count=3,&lt;/code&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="755" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-neq" value="&amp;#8800;" style="text;html=1;align=center;verticalAlign=middle;fontSize=34;fontStyle=1;fontFamily=Helvetica;fontColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="550" y="780" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c-real" value="&lt;div&gt;&lt;b&gt;What the account says&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;aws ecs describe-services&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;desiredCount: 5&lt;/code&gt; - five tasks running&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="630" y="755" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-note" value="&lt;div&gt;&lt;b&gt;The rule&lt;/b&gt;&lt;/div&gt;&lt;div&gt;If you did it with the CLI, put it in the code afterwards. Otherwise the next deploy silently undoes your change, usually at the worst possible moment.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#3F8624;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="755" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="band-d" value="So which one do you use" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="895" width="1450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;div&gt;&lt;b&gt;Reach for the CLI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Classroom demos, live incidents, quick experiments. Anything you intend to undo within the hour.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="935" width="450" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;div&gt;&lt;b&gt;Reach for CDK&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Permanent changes, anything another person should review, anything that has to be reproducible in a second account.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#3F8624;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="935" width="450" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;div&gt;&lt;b&gt;Same path for the other knobs&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;min_capacity&lt;/code&gt;, &lt;code&gt;max_capacity&lt;/code&gt; and the CPU target live in the same file and change the same way.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="935" width="440" height="90" as="geometry" />
        </mxCell>

        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1540" y="30" width="650" height="1015" as="geometry" />
        </mxCell>

        <mxCell id="h-a" value="Path A - the CLI" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#ED7100;" vertex="1" parent="1">
          <mxGeometry x="1560" y="52" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="86" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" value="&lt;div&gt;&lt;b&gt;You type one command&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;aws ecs update-service --cluster container-demo --service ecsdemo-frontend --desired-count 5&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="84" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="176" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" value="&lt;div&gt;&lt;b&gt;The ECS API accepts it immediately&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;No template, no change set, no review. The service property is simply overwritten.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="174" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="256" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" value="&lt;div&gt;&lt;b&gt;The rollout takes minutes&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The scheduler pulls images and starts tasks; the ALB only sends traffic once the health check passes.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="254" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="336" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" value="&lt;div&gt;&lt;b&gt;And now the code is wrong&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Five tasks run, the repository still claims three. Nothing warns you until the next deploy reverts it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="334" width="558" height="80" as="geometry" />
        </mxCell>

        <mxCell id="h-b" value="Path B - CDK" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#3F8624;" vertex="1" parent="1">
          <mxGeometry x="1560" y="426" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="460" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s5-desc" value="&lt;div&gt;&lt;b&gt;You change the number in the code&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;desired_count=3&lt;/code&gt; becomes &lt;code&gt;desired_count=5&lt;/code&gt; in &lt;code&gt;ecsdemo-frontend/cdk/app.py&lt;/code&gt;.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="458" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="540" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s6-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk diff&lt;/code&gt; is the evidence&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;It prints exactly one line: &lt;code&gt;AWS::ECS::Service DesiredCount 3 to 5&lt;/code&gt;. That output is what a reviewer approves.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="538" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="620" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s7-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk deploy&lt;/code&gt; updates the stack&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;CloudFormation changes only what differs. Existing tasks are not restarted when DesiredCount is the only change.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="618" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="700" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s8-desc" value="&lt;div&gt;&lt;b&gt;The rollout is the same as path A&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;ECS and the ALB do identical work. The difference is never in the rollout, it is in what the repository knows.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="698" width="558" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s9-badge" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="780" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s9-desc" value="&lt;div&gt;&lt;b&gt;The commit closes the loop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Now the change has an author, a date and a reason, and a second account can be brought to the same state by running the same code.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="778" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ls-box" value="Line styles" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="885" width="610" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ls1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="925" as="sourcePoint" />
            <mxPoint x="1640" y="925" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls1t" value="The path the change travels" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="911" width="420" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3F8624;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="957" as="sourcePoint" />
            <mxPoint x="1640" y="957" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls2t" value="The step that keeps code and reality in agreement" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="943" width="460" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;dashed=1;dashPattern=8 6;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="989" as="sourcePoint" />
            <mxPoint x="1640" y="989" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls3t" value="The consequence nobody asked for: drift" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="975" width="460" height="28" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
