        </mxCell>

        <mxCell id="band-c" value="Behind the scenes" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="665" width="1450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk.out/&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The synthesized templates and the assets. Everything &lt;code&gt;deploy&lt;/code&gt; uploads is read from here, never from your source tree.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="705" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;div&gt;&lt;b&gt;Bootstrap S3 bucket and IAM roles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Created once per account and Region by &lt;code&gt;cdk bootstrap&lt;/code&gt;. CDK assumes those roles to upload assets and call CloudFormation.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="705" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;div&gt;&lt;b&gt;The CloudFormation stack&lt;/b&gt;&lt;/div&gt;&lt;div&gt;CREATE, UPDATE or ROLLBACK. The stack owns your resources: the CLI only asks it to converge on the template.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1030" y="705" width="430" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;div&gt;&lt;b&gt;In this lab&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;source venv/bin/activate &amp;amp;&amp;amp; source .env&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;cd ecsdemo-frontend/cdk&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;cdk diff --profile &amp;lt;profile&amp;gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;cdk deploy --profile &amp;lt;profile&amp;gt; --tags Team=&amp;lt;team&amp;gt; --require-approval never&lt;/code&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="835" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;div&gt;&lt;b&gt;Where it usually goes wrong&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Skipping bootstrap: deploy fails with an SSM parameter not found.&lt;/div&gt;&lt;div&gt;- Changing something in the console and watching the next deploy undo it (drift).&lt;/div&gt;&lt;div&gt;- Missing tags or permissions, so the stack lands in ROLLBACK.&lt;/div&gt;&lt;div&gt;- Mismatched versions between the Python library and the CDK CLI.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="835" width="720" height="150" as="geometry" />
        </mxCell>

