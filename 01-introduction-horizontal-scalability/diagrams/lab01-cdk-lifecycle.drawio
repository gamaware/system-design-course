        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1540" y="30" width="650" height="975" as="geometry" />
        </mxCell>

        <mxCell id="s1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="62" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk init app --language python&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Creates the project skeleton: &lt;code&gt;app.py&lt;/code&gt;, &lt;code&gt;cdk.json&lt;/code&gt;, &lt;code&gt;requirements.txt&lt;/code&gt; and a virtual environment. Run once, when the project is born.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="60" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="162" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk bootstrap&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Deploys the CDKToolkit stack: an S3 bucket for assets plus the IAM roles CDK assumes. One per account and Region, not per project.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="160" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="262" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk synth&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Executes your Python and writes a CloudFormation template plus assets into &lt;code&gt;cdk.out/&lt;/code&gt;. If your code has a bug, this is where it surfaces.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="260" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="362" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk diff&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Compares &lt;code&gt;cdk.out&lt;/code&gt; against the deployed stack and lists what would be created, changed or deleted, down to a single property such as DesiredCount 3 to 5.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="360" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="462" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s5-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk deploy&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Uploads the assets to the bootstrap bucket and asks CloudFormation to create or update the stack. The CLI then streams the events until the stack settles.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="460" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="562" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s6-desc" value="&lt;div&gt;&lt;b&gt;Observe, then iterate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Check the service in ECS, the ALB and CloudWatch. Any change goes back into the code, not into the console, and the synth, diff, deploy loop runs again.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="560" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="662" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s7-desc" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;cdk destroy&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Deletes the stack and everything in it that is not marked RETAIN. In this lab the four stacks come down in reverse order of their dependencies.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="660" width="558" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ls-box" value="Line styles" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="765" width="610" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ls1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="805" as="sourcePoint" />
            <mxPoint x="1640" y="805" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls1t" value="The lifecycle, run in order" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="791" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=2;dashed=1;dashPattern=8 6;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="835" as="sourcePoint" />
            <mxPoint x="1640" y="835" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls2t" value="The daily loop: back to synth after every edit" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="821" width="380" height="28" as="geometry" />
        </mxCell>

        <mxCell id="notes-box" value="&lt;div&gt;&lt;b&gt;Commands worth remembering&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;- &lt;code&gt;cdk ls&lt;/code&gt;&lt;/b&gt; lists the stacks in the app.&lt;/div&gt;&lt;div&gt;&lt;b&gt;- &lt;code&gt;cdk doctor&lt;/code&gt;&lt;/b&gt; checks the local environment and versions.&lt;/div&gt;&lt;div&gt;&lt;b&gt;- &lt;code&gt;cdk deploy --all --require-approval never&lt;/code&gt;&lt;/b&gt; deploys every stack without prompting.&lt;/div&gt;&lt;div&gt;&lt;b&gt;- &lt;code&gt;cdk destroy --force&lt;/code&gt;&lt;/b&gt; tears a stack down without asking for confirmation.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;spacingRight=12;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="870" width="610" height="115" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
