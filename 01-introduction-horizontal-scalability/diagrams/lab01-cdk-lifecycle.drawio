<mxfile host="Electron" version="29.6.1">
  <diagram name="Page-1" id="lab01-cdk-lifecycle">
    <mxGraphModel dx="2400" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2250" pageHeight="1090" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-group" value="" style="group;fontFamily=Helvetica;" connectable="0" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1450" height="83" as="geometry" />
        </mxCell>
        <mxCell id="title-text" value="Lab 01 - The AWS CDK Lifecycle" style="text;html=1;resizable=1;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group">
          <mxGeometry width="1430" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" value="One command per stage, from an empty folder to a running stack and back to an empty account" style="text;html=1;resizable=0;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group">
          <mxGeometry x="5" y="40" width="1425" height="25" as="geometry" />
        </mxCell>
        <mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group">
          <mxGeometry x="5" y="70" width="1440" height="10" as="geometry" />
        </mxCell>

        <mxCell id="band-a" value="What AWS CDK is" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="1450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;div&gt;&lt;b&gt;Infrastructure as code, in a real language&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Python or TypeScript classes describe the VPC, the cluster and the load balancer. No hand-written YAML.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;div&gt;&lt;b&gt;Three levels of construct&lt;/b&gt;&lt;/div&gt;&lt;div&gt;L1 is raw CloudFormation. L2 adds sane defaults (&lt;code&gt;ec2.Vpc&lt;/code&gt;, &lt;code&gt;ecs.Cluster&lt;/code&gt;). L3 patterns ship a whole architecture in one object.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="195" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;div&gt;&lt;b&gt;App, stacks, constructs&lt;/b&gt;&lt;/div&gt;&lt;div&gt;One app can hold several stacks. This lab has four: base, frontend, nodejs and crystal, each deployed on its own.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="790" y="195" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;div&gt;&lt;b&gt;CDK does not deploy anything&lt;/b&gt;&lt;/div&gt;&lt;div&gt;It synthesizes a CloudFormation template, and CloudFormation creates the resources. The code stays the source of truth.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="195" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="band-b" value="Lifecycle" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="325" width="1450" height="315" as="geometry" />
        </mxCell>

