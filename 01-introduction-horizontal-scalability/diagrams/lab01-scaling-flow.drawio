        <mxCell id="band-c" value="If the autoscaler is switched on, it will undo you" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#ED7100;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#ED7100;container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="1450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;div&gt;&lt;b&gt;What you see&lt;/b&gt;&lt;/div&gt;&lt;div&gt;You set five tasks by hand. The service is idle, so AlarmLow fires fifteen minutes later and walks the count back: five, four, three, and on down to &lt;code&gt;min_capacity&lt;/code&gt;. Nothing is broken; two controllers simply disagree about who owns the number.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="745" width="660" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div&gt;&lt;b&gt;How to take the wheel back&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;aws application-autoscaling register-scalable-target&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;  --service-namespace ecs --scalable-dimension ecs:service:DesiredCount&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;  --resource-id &amp;lt;service&amp;gt; --suspended-state \&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;  DynamicScalingInSuspended=true,DynamicScalingOutSuspended=true&lt;/code&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=12;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="745" width="710" height="115" as="geometry" />
        </mxCell>

        <mxCell id="band-d" value="What the lab teaches" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="905" width="1450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;div&gt;&lt;b&gt;Scale-out is never instant&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Image pull plus startup plus health check.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="945" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;div&gt;&lt;b&gt;Pick one controller&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Either you own desiredCount or the autoscaler does, never both at once.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="945" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;div&gt;&lt;b&gt;Generate load inside the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A laptop over the internet will not saturate the tasks.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="945" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;div&gt;&lt;b&gt;Keep the load running&lt;/b&gt;&lt;/div&gt;&lt;div&gt;If the generator dies on a 502, the CPU falls and the alarm never collects its three minutes.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="950" y="945" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;div&gt;&lt;b&gt;Watch three things at once&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The metric, the alarm state and the scaling activity. One of them alone tells you nothing.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1240" y="945" width="240" height="95" as="geometry" />
        </mxCell>

        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1540" y="30" width="650" height="1035" as="geometry" />
        </mxCell>

        <mxCell id="h-a" value="Scale-out, by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="1560" y="52" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="88" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" value="&lt;div&gt;&lt;b&gt;Where you start&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Three tasks, three healthy targets. Confirm it with &lt;code&gt;aws ecs describe-services&lt;/code&gt; before you change anything.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="86" width="558" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="180" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" value="&lt;div&gt;&lt;b&gt;You raise the number&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;--desired-count 5&lt;/code&gt;. The API returns in under a second, which is the part that misleads people.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="178" width="558" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="272" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" value="&lt;div&gt;&lt;b&gt;The scheduler does the slow part&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Two tasks go PENDING, pull their image and start. Watch them with &lt;code&gt;aws ecs list-tasks&lt;/code&gt; or in the console.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="270" width="558" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="364" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" value="&lt;div&gt;&lt;b&gt;Only now do you have capacity&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The ALB forwards to a task only after its health check passes. Measured end to end: about four to five minutes.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="362" width="558" height="82" as="geometry" />
        </mxCell>

        <mxCell id="h-b" value="Scale-in, by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;fontColor=#3F8624;" vertex="1" parent="1">
          <mxGeometry x="1560" y="460" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="496" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s5-desc" value="&lt;div&gt;&lt;b&gt;You lower the number&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;&lt;code&gt;--desired-count 1&lt;/code&gt;. Same command, same API, opposite direction.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="494" width="558" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="588" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s6-desc" value="&lt;div&gt;&lt;b&gt;The ALB drains before ECS stops&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Four targets are deregistered and their in-flight requests are allowed to finish. That is why nobody sees an error while the service shrinks.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="586" width="558" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="680" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s7-desc" value="&lt;div&gt;&lt;b&gt;One task, about sixteen seconds later&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Compare that with the four to five minutes it took to grow. Capacity is cheap to give back and expensive to get.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="678" width="558" height="82" as="geometry" />
        </mxCell>

        <mxCell id="ls-box" value="Line styles" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="780" width="610" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ls1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="820" as="sourcePoint" />
            <mxPoint x="1640" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls1t" value="Scale-out, the slow direction" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="806" width="420" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3F8624;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="855" as="sourcePoint" />
            <mxPoint x="1640" y="855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls2t" value="Scale-in, the fast direction" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="841" width="420" height="28" as="geometry" />
        </mxCell>

        <mxCell id="notes-box" value="&lt;div&gt;&lt;b&gt;Before you set a CPU target&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A single-threaded app on 0.25 vCPU alternates between idle and fully busy, so its average settles near 50 % however hard you push it. Pick a target below that plateau, or the high alarm will never fire. This lab uses 30 % for exactly that reason, and measuring your own plateau first is the habit worth taking away.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;spacingRight=12;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="905" width="610" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
