        <mxCell id="b-note" value="&lt;div&gt;&lt;b&gt;Why scale-in is the fast direction&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Stopping a task is a signal plus a drain. Nothing has to be downloaded, started or proved healthy, so the whole move finishes in seconds. Plan your capacity around the slow direction, not this one.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1000" y="505" width="480" height="120" as="geometry" />
        </mxCell>

