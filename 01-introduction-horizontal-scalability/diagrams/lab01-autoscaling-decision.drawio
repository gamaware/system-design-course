          <mxGeometry x="140" y="800" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;div&gt;&lt;b&gt;t = 3&lt;/b&gt; AlarmHigh fires and the count jumps straight to eight tasks.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontSize=12;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="455" y="800" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;div&gt;&lt;b&gt;t = 5 to 8&lt;/b&gt; CPU settles near 30 %, then the load stops and it drops to about 1 %.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontSize=12;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="800" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;div&gt;&lt;b&gt;t = 23 onwards&lt;/b&gt; AlarmLow finally fires and tasks come off about one every two minutes.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontSize=12;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1085" y="800" width="330" height="48" as="geometry" />
        </mxCell>

        <mxCell id="band-c" value="The four knobs, all of them in ecsdemo-frontend/cdk/app.py" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#879196;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=14;fontStyle=1;fontColor=light-dark(#333333,#FAFAFA);container=0;pointerEvents=0;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="880" width="1450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;desired_count=3&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Where the service starts. Auto Scaling takes over from this number.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="920" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;min_capacity=1&lt;/code&gt; and &lt;code&gt;max_capacity=10&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Floor and ceiling. The formula is clamped between them, always.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="920" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;target_utilization_percent=30&lt;/code&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The thermostat setting. Everything else follows from this one number.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="790" y="920" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;scale_in_cooldown&lt;/code&gt; and &lt;code&gt;scale_out_cooldown&lt;/code&gt;, 30 s&lt;/b&gt;&lt;/div&gt;&lt;div&gt;How long the loop waits after acting before it is allowed to act again.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="920" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1540" y="30" width="650" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="s1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="62" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1-desc" value="&lt;div&gt;&lt;b&gt;Traffic arrives and burns CPU&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The ALB spreads requests over the running tasks. Each task has 0.25 vCPU, so a few concurrent clients already move the number.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="60" width="558" height="92" as="geometry" />
        </mxCell>

        <mxCell id="s2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="172" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2-desc" value="&lt;div&gt;&lt;b&gt;CloudWatch averages the service&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;One &lt;code&gt;CPUUtilization&lt;/code&gt; datapoint per minute for the whole service, not per task. Target tracking never looks at requests per second or latency unless you add that metric yourself.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="170" width="558" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="300" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3-desc" value="&lt;div&gt;&lt;b&gt;Two alarms, not one&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Target tracking creates them for you. AlarmHigh needs 3 datapoints above the target, AlarmLow needs 15 below it. That asymmetry is deliberate: grow fast, shrink carefully.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="298" width="558" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="428" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s4-desc" value="&lt;div&gt;&lt;b&gt;The arithmetic is simple&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Auto Scaling multiplies the running tasks by the ratio of current CPU to target CPU and rounds up. It does not step by one: it aims straight at the count that should bring the metric back to target.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="426" width="558" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1560" y="556" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s5-desc" value="&lt;div&gt;&lt;b&gt;The service gets a new desiredCount&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;ECS starts or stops tasks to match, the ALB registers them, and the next minute of metrics already reflects the change. The loop has closed.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1612" y="554" width="558" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ls-box" value="Line styles" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="670" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ls1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="710" as="sourcePoint" />
            <mxPoint x="1640" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls1t" value="Traffic and its effect on the tasks" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="696" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3F8624;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="740" as="sourcePoint" />
            <mxPoint x="1640" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls2t" value="Metric reaching CloudWatch" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="726" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="770" as="sourcePoint" />
            <mxPoint x="1640" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls3t" value="Alarm, decision and scale-out (also the solid curve)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="756" width="440" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ls4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;dashPattern=8 6;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="800" as="sourcePoint" />
            <mxPoint x="1640" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ls4t" value="Feedback, and the gradual scale-in staircase" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="1">
          <mxGeometry x="1652" y="786" width="440" height="28" as="geometry" />
        </mxCell>

        <mxCell id="notes-box" value="&lt;div&gt;&lt;b&gt;Two traps this lab walks into&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;- The ceiling is real.&lt;/b&gt; With ten tasks at 100 % CPU the alarm stays in ALARM but the count never passes &lt;code&gt;max_capacity&lt;/code&gt;. Raise the ceiling or give each task more CPU.&lt;/div&gt;&lt;div&gt;&lt;b&gt;- Measure before you pick a target.&lt;/b&gt; A single-threaded app on 0.25 vCPU alternates between 0 and 100 %, so its average plateau sits near 50 %. With a 50 % target the alarm never fires, which is why this lab uses 30 %.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;spacingRight=12;fontSize=13;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
          <mxGeometry x="1560" y="835" width="610" height="175" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
