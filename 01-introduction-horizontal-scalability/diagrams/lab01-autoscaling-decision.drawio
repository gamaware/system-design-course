        <mxCell id="formula" value="&lt;div&gt;&lt;b&gt;new desiredCount = ceil( running tasks &amp;times; current CPU / target CPU )&lt;/b&gt;&lt;/div&gt;&lt;div&gt;In the lab: ceil( 3 tasks &amp;times; 75 % / 30 % ) = 8 tasks, then clamped to min 1 and max 10&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2E8;strokeColor=#ED7100;verticalAlign=middle;align=center;fontSize=14;fontColor=light-dark(#000000,#000000);fontFamily=Helvetica;container=0;" vertex="1" parent="1">
