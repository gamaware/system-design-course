        <mxCell id="e5-label" value="DNS failover" style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#8C4FFF;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e5">
