        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="30" width="650" height="800" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="62" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;The members elect a primary&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; &lt;b&gt;rs.initiate&lt;/b&gt; declares the three members. They vote, and mongo1 wins because its priority is 2 against 1. Exactly one primary exists at a time.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="60" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="152" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Every write lands on the primary&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; &lt;b&gt;insertOne&lt;/b&gt; is accepted only by mongo1. With &lt;b&gt;w:majority&lt;/b&gt; the call waits until 2 of the 3 members have stored the change.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="150" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="242" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;The oplog carries the change&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Both secondaries tail the primary's operation log and replay it, so all three members converge on the same documents.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="240" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="332" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Reading the primary is the safe read&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; A &lt;b&gt;find&lt;/b&gt; on mongo1 sees the write that was just acknowledged, because the primary holds the authoritative copy.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="330" width="548" height="74" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="422" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Reading a secondary spreads the load&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; With &lt;b&gt;setReadPref('secondary')&lt;/b&gt; the query runs on mongo2. The answer can be a moment behind the primary, which is the price of the extra read capacity.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="420" width="548" height="94" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="532" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;A secondary refuses writes&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; The same insert sent to mongo3 fails with &lt;b&gt;not primary&lt;/b&gt;. One writer keeps the order of operations single and the oplog linear, so no member can diverge.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="530" width="548" height="94" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="642" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Heartbeats decide the next primary&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Members ping each other. If mongo1 disappears, mongo2 and mongo3 are still 2 of 3 and elect a new primary on their own. MySQL needs an operator for the same step.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1244" y="640" width="548" height="94" as="geometry" />
        </mxCell>
        <mxCell id="legend-footer-box" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1192" y="722" width="606" height="88" as="geometry" />
        </mxCell>
        <mxCell id="legend-footer-text" value="&lt;div&gt;&lt;b&gt;What the Compose file starts&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;-&lt;/b&gt; Three &lt;b&gt;mongo:7&lt;/b&gt; containers started with &lt;b&gt;--replSet rs0&lt;/b&gt;, published on ports 27017, 27018 and 27019, each with its own volume.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1202" y="730" width="586" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
