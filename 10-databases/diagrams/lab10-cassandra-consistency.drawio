        <mxCell id="rf-text" value="&lt;div&gt;&lt;b&gt;Keyspace university&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;NetworkTopologyStrategy with &lt;b&gt;dc1 = 3&lt;/b&gt;. Replication factor 3 over 3 nodes, so every node stores every row.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=2;spacingLeft=6;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="868" y="198" width="164" height="104" as="geometry" />
        </mxCell>
